---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Ladder from '../components/Ladder.astro';
import Timeline from '../components/Timeline.astro';
import LineChart from '../components/LineChart.astro';
import SectionMap from '../components/SectionMap.astro';
import tt from '../../public/data/runs/p1_02_traveltime.json';
import sc3 from '../../public/data/runs/p1_03_scattered.json';
import am from '../../public/data/runs/p1_04_ambient.json';
import m1 from '../../public/data/runs/m1_01_ambient_levels.json';
import sees from '../../public/data/runs/p2_03_what_a_dwell_sees.json';
import imp from '../../public/data/runs/p2_04_chamber_imprint.json';
import bud from '../../public/data/runs/p2_05_budget.json';
import dep from '../../public/data/runs/p2_06_depth_is_frequency.json';
import type { TourStop } from '../viewer/Underworld';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const stops: TourStop[] = [
  { site: 'bench-shafts', caption: '<b>Test bench</b>Twelve burial shafts, 8 to 30 m deep, in fractured limestone: the scale of Giza’s cemeteries.' },
  { site: 'bench-void', mode: 'recovered', item: 'tt-crosshole', caption: '<b>Test bench · recovered</b>One chamber, and what four boreholes recover of it: a shadow, 11% slower than the rock.' },
  { site: 'bench-void', mode: 'waves', item: 'echo', seconds: 8, caption: '<b>Test bench · the echo</b>A hammer blow at the surface, and what comes back from the chamber: too faint to see on any single record.' },
  { site: 'bench-khafre-claim', caption: '<b>The claim, placed as stated</b>Eight shafts to 640 m beneath Khafre, and a deeper structure near 1,220 m.' },
  { site: 'giza', caption: '<b>Real site</b>Giza on Copernicus terrain, with the chambers already surveyed inside and beneath the pyramids.' },
];

// Phase 2, simulated on the real Giza geometry and checked on its real image (sim/results/p2_0*).
const SUP = '⁰¹²³⁴⁵⁶⁷⁸⁹';
const order = (v: number) => `10${String(Math.round(Math.log10(v))).replace('-', '⁻').replace(/\d/g, (d) => SUP[+d])}`;
const blk = sees.real.block;
const plateau = (bud.rows as { case: string; target: string; shortfall: number | null; a_min_m_s: number | null }[])
  .filter((r) => r.case === imp.cases[0].case);
const budget = [
  { value: `${(blk.gain_complex * 100).toFixed(0)}`, unit: '%', what: 'of a stretch of real ground’s motion recovered by registering one image’s looks against each other, as the published method does: the looks share their spectrum', src: 'P2-03 · the real Giza image' },
  { value: `${(imp.cases[0].imprint_over_motion * 1e5).toFixed(1)}`, unit: '× 10⁻⁵', what: 'of the ground’s own motion is all a 6 m chamber 15 m down changes as a microseism passes', src: 'P2-04 · the lab’s solver' },
  { value: order(plateau[1].shortfall!), unit: '×', what: `short of that imprint on the plateau, ${order(plateau[2].shortfall!)} on a bright scatterer above it, allowing every look and a 3-sigma threshold`, src: 'P2-05 · the budget' },
  { value: (dep.metres_per_hz as number).toFixed(2), unit: 'm/Hz', what: 'of published depth per hertz of ground motion, whatever lies below: the depth axis is a frequency axis', src: 'P2-06 · the published focusing' },
];

const cx = tt.surveys.crosshole;
const holesXZ = (cx.stations.receivers as number[][]).filter((p) => Math.abs(p[1]) < 0.3).map((p) => [p[0], p[2]] as [number, number]);
---
<Base current="home">
  <Hero stops={stops} />

  <div class="home">
    <section class="claim">
      <div class="claim-text">
        <p class="label">The claim</p>
        <h2>One radar image, reprocessed, said to show a city 600 m underground</h2>
        <p class="prose">
          The idea is that a single satellite radar image holds the faint vibration of the ground, and that splitting it into
          sub-apertures turns that vibration into a picture of what lies hundreds of metres below. It was published in
          2022, announced beneath Khafre in 2025, and retracted in 2026. No one has shown it working on ground whose contents
          are known. That is what this lab does. <a href={`${base}/claim/`}>The claim in full</a>
        </p>
      </div>
      <Timeline />
    </section>

    <section class="block">
      <div class="head">
        <p class="label">The ladder of instruments</p>
        <h2>The further an instrument sits from a chamber, the harder the chamber is to see</h2>
        <p class="sub">
          One chamber, 6 m across and 12 m down in limestone. Every way of looking for it, from a borehole beside it to a
          satellite 600 km away, is simulated over the same ground and scored against the truth.
        </p>
      </div>
      <Ladder />
    </section>

    <section class="block">
      <div class="head">
        <p class="label">Latest results</p>
        <h2>From orbit the chamber is out of reach; from the ground, some instruments find it</h2>
      </div>
      <div class="results">
        <a class="result card" href={`${base}/satellite/`}>
          <span class="tag simulated">simulated and real · P2-03</span>
          <h3>One radar image cannot see the ground move</h3>
          <LineChart
            series={[
              { name: 'put in', x: (sees.motion.look_times_s as number[]).map((t, _, a) => t - a[Math.floor(a.length / 2)]), y: (blk.injected_relative as number[]).map((v) => v * 1e6), color: 'var(--text)', width: 1.5 },
              { name: 'read from the image', x: (sees.motion.look_times_s as number[]).map((t, _, a) => t - a[Math.floor(a.length / 2)]), y: (blk.complex as number[]).map((v) => v * 1e6), color: 'var(--cinnabar)', markers: true },
            ]}
            xLabel="look time, s"
            yLabel="µm/s"
            height={150}
            zeroLine
            directLabels={false}
          />
          <p>A block of the real Giza image made to sway at 2 mm/s: the published way of reading motion recovers {(blk.gain_complex * 100).toFixed(0)}% of it. A chamber changes the ground’s motion by one part in {(Math.round(1 / imp.cases[0].imprint_over_motion / 1000) * 1000).toLocaleString('en-US')}, and the published depth is only the motion’s frequency.</p>
        </a>
        <a class="result card" href={`${base}/seismic/#traveltime`}>
          <span class="tag simulated">simulated · P1-02</span>
          <h3>Four boreholes recover the chamber's shadow; the surface sees nothing</h3>
          <div class="mini-map"><SectionMap
            title=""
            x={cx.slices.x}
            y={cx.slices.z}
            values={cx.slices.xz_rel}
            domain={0.08}
            outlines={[{ x0: -3, x1: 3, y0: -18, y1: -12 }]}
            points={holesXZ}
            xLabel="east, m"
            yLabel="height, m"
            width={320}
          /></div>
          <p>Crosshole travel-time tomography: the chamber comes back {(100 * cx.score.chamber_mean_rel).toFixed(0)}% slow, where air is 90% slow — travel times see the detour, not the emptiness.</p>
        </a>
        <a class="result card" href={`${base}/seismic/#echo`}>
          <span class="tag simulated">simulated · P1-03</span>
          <h3>The chamber's echo, below the noise on every record, images it from the surface</h3>
          <div class="mini-map"><SectionMap
            title=""
            x={sc3.slices.x}
            y={sc3.slices.z}
            values={sc3.slices.xz_image}
            domain={0.6}
            scale="sequential"
            outlines={[{ x0: -3, x1: 3, y0: -18, y1: -12 }]}
            xLabel="east, m"
            yLabel="height, m"
            width={320}
          /></div>
          <p>Reverse-time migration of the scattered wave, with the rock known exactly: the image is {sc3.score.contrast.toFixed(0)}× brighter at the chamber than elsewhere, strongest on its top face.</p>
        </a>
        <a class="result card" href={`${base}/seismic/#ambient`}>
          <span class="tag simulated">simulated · P1-04</span>
          <h3>Ambient noise stands in for the hammer, but sees the chamber only faintly</h3>
          <div class="mini-map"><SectionMap
            title=""
            x={am.slices.x}
            y={am.slices.z}
            values={am.slices.xz_image}
            domain={0.6}
            scale="sequential"
            outlines={[{ x0: -3, x1: 3, y0: -18, y1: -12 }]}
            xLabel="east, m"
            yLabel="height, m"
            width={320}
          /></div>
          <p>Footsteps and traffic, correlated between geophones, bring back the wave a hammer would send (correlation {am.retrieval.ncc.toFixed(2)}). Imaged with the rock known exactly, the chamber stands at {am.score.image_contrast_ensemble.toFixed(1)}× the rest, where the hammer reached {sc3.score.contrast.toFixed(0)}×, however long the noise is recorded.</p>
        </a>
      </div>
    </section>
  </div>

  <section class="deep-band">
    <div class="home">
      <div class="head">
        <span class="tag simulated on-deep">simulated on the real geometry, checked on the real image</span>
        <h2>One radar image misses the chamber three independent ways</h2>
        <p class="sub">
          Phase 2: the estimator cannot see ground move, the chamber barely changes how it moves, and the depth axis is a
          frequency axis. Each is sufficient alone.{' '}
          <a href={`${base}/satellite/`}>The satellite →</a>
        </p>
      </div>
      <div class="stat-row deep">
        {
          budget.map((b) => (
            <div class="stat">
              <span class="value">
                {b.value}
                <small>{b.unit}</small>
              </span>
              <span class="what">{b.what}</span>
              <span class="src">{b.src}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .home {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .claim {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 24px 48px;
    align-items: start;
    padding: 44px 0 34px;
    border-bottom: 1px solid var(--border);
  }
  .claim h2,
  .head h2 {
    font-family: var(--font-serif);
    font-size: 25px;
    font-weight: 500;
    line-height: 1.2;
    margin: 8px 0 10px;
  }
  .claim .prose {
    font-size: 15px;
  }
  .block {
    padding: 38px 0 6px;
  }
  .head {
    max-width: 780px;
    margin-bottom: 20px;
  }
  .sub {
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.6;
    color: var(--body);
  }
  .results {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .result {
    display: block;
    padding: 18px 20px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .result:hover {
    border-color: var(--border-strong);
    box-shadow: 0 2px 14px rgba(28, 40, 51, 0.07);
  }
  .result h3 {
    font-size: 15px;
    margin: 10px 0 10px;
  }
  .result p {
    font-family: var(--font-serif);
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--body);
    margin-top: 8px;
  }
  .mini-map {
    max-width: 340px;
  }
  .deep-band {
    margin-top: 48px;
    background: var(--deep);
    background-image: radial-gradient(90% 120% at 85% 0%, rgba(91, 143, 224, 0.1), transparent 60%);
    color: var(--panel-text);
    padding: 42px 0 46px;
  }
  .deep-band h2 {
    color: #eef3f7;
  }
  .deep-band .sub {
    color: var(--panel-muted);
  }
  .deep-band .sub a {
    color: var(--panel-text);
  }
  .tag.on-deep {
    color: var(--panel-muted);
    border-color: var(--panel-line);
  }
  .stat-row.deep {
    background: var(--panel-line);
    border-color: var(--panel-line);
  }
  .stat-row.deep .stat {
    background: var(--panel-bg);
  }
  .stat-row.deep .value {
    color: #eef3f7;
  }
  .stat-row.deep .value small,
  .stat-row.deep .src {
    color: var(--panel-faint);
  }
  .stat-row.deep .what {
    color: var(--panel-muted);
  }
  @media (max-width: 900px) {
    .home {
      padding: 0 16px;
    }
    .claim,
    .results {
      grid-template-columns: 1fr;
    }
  }
</style>
