---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Ladder from '../components/Ladder.astro';
import Timeline from '../components/Timeline.astro';
import LineChart from '../components/LineChart.astro';
import SectionMap from '../components/SectionMap.astro';
import v01 from '../../public/data/runs/p1_01_forward_validation.json';
import tt from '../../public/data/runs/p1_02_traveltime.json';
import type { TourStop } from '../viewer/Underworld';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const stops: TourStop[] = [
  { site: 'bench-shafts', caption: '<b>Test bench</b>Twelve burial shafts, 8 to 30 m deep, in fractured limestone: the scale of Giza’s cemeteries.' },
  { site: 'bench-void', mode: 'recovered', item: 'tt-crosshole', caption: '<b>Test bench · recovered</b>One chamber, and what four boreholes recover of it: a shadow, 11% slower than the rock.' },
  { site: 'bench-void', mode: 'waves', item: 'echo', seconds: 8, caption: '<b>Test bench · the echo</b>A hammer blow at the surface, and what comes back from the chamber: too faint to see on any single record.' },
  { site: 'bench-khafre-claim', caption: '<b>The claim, placed as stated</b>Eight shafts to 640 m beneath Khafre, and a deeper structure near 1,220 m.' },
  { site: 'giza', caption: '<b>Real site</b>Giza on Copernicus terrain, with the chambers already surveyed inside and beneath the pyramids.' },
];

// Measured on the real ICEYE dwell over Giza in the first investigation (sim/legacy/results/r14_budget).
const budget = [
  { value: '1,277', unit: '×', what: 'short of radar reach: X-band enters 11–51 cm of dry limestone; the claim needs 648 m', src: 'R14 · radar reach' },
  { value: '81', unit: '×', what: 'short of record length: the coherent window allows 1.86 s; the microseism band needs about 150 s', src: 'R14 · record length' },
  { value: '8', unit: '×', what: 'short of motion sensitivity: the measured floor is 77 µm/s; ambient ground motion is 0.1–10 µm/s', src: 'R14 · sensitivity' },
  { value: '97', unit: '×', what: 'short of lateral resolution: waves that reach 648 m resolve about 970 m, against wells said to be 10 m across', src: 'R14 · resolution' },
];

const st = v01.stokes.panels[0];
const cx = tt.surveys.crosshole;
const holesXZ = (cx.stations.receivers as number[][]).filter((p) => Math.abs(p[1]) < 0.3).map((p) => [p[0], p[2]] as [number, number]);
---
<Base current="home">
  <Hero stops={stops} />

  <div class="home">
    <section class="claim">
      <div class="claim-text">
        <p class="label">The claim</p>
        <h2>One radar image, reprocessed, said to show a city 600 m underground</h2>
        <p class="prose">
          The idea is that a single satellite radar image holds the faint vibration of the ground, and that splitting it into
          sub-apertures turns that vibration into a picture of what lies hundreds of metres below. It was published in
          2022, announced beneath Khafre in 2025, and retracted in 2026. No one has shown it working on ground whose contents
          are known. That is what this lab does. <a href={`${base}/claim/`}>The claim in full</a>
        </p>
      </div>
      <Timeline />
    </section>

    <section class="block">
      <div class="head">
        <p class="label">The ladder of instruments</p>
        <h2>The further an instrument sits from a chamber, the harder the chamber is to see</h2>
        <p class="sub">
          One chamber, 6 m across and 12 m down in limestone. Every way of looking for it, from a borehole beside it to a
          satellite 600 km away, is simulated over the same ground and scored against the truth.
        </p>
      </div>
      <Ladder />
    </section>

    <section class="block">
      <div class="head">
        <p class="label">Latest results</p>
        <h2>A validated wave solver, and the first chamber recovered</h2>
      </div>
      <div class="results">
        <a class="result card" href={`${base}/seismic/#forward`}>
          <span class="tag simulated">simulated · P1-01</span>
          <h3>The solver matches exact solutions to within {(100 * v01.stokes.worst_amplitude_error).toFixed(1)}%</h3>
          <LineChart
            series={[
              { name: 'exact', x: st.t_ms, y: st.exact, color: 'var(--text)', width: 1.5 },
              { name: 'simulated', x: st.t_ms, y: st.simulated, color: 'var(--verdigris)', dash: '4 3' },
            ]}
            xLabel="time, ms"
            yLabel="velocity"
            height={150}
            zeroLine
            directLabels={false}
          />
          <p>A point force in Mokattam limestone against the Stokes solution; the Rayleigh wave within 0.5% of its exact speed.</p>
        </a>
        <a class="result card" href={`${base}/seismic/#traveltime`}>
          <span class="tag simulated">simulated · P1-02</span>
          <h3>Four boreholes recover the chamber's shadow; the surface sees nothing</h3>
          <div class="mini-map"><SectionMap
            title=""
            x={cx.slices.x}
            y={cx.slices.z}
            values={cx.slices.xz_rel}
            domain={0.08}
            outlines={[{ x0: -3, x1: 3, y0: -18, y1: -12 }]}
            points={holesXZ}
            xLabel="east, m"
            yLabel="height, m"
            width={320}
          /></div>
          <p>Crosshole travel-time tomography: the chamber comes back {(100 * cx.score.chamber_mean_rel).toFixed(0)}% slow, where air is 90% slow — travel times see the detour, not the emptiness.</p>
        </a>
      </div>
    </section>
  </div>

  <section class="deep-band">
    <div class="home">
      <div class="head">
        <span class="tag measured on-deep">measured on the real acquisition</span>
        <h2>Radar from orbit misses four independent requirements, each by a wide margin</h2>
        <p class="sub">
          From the first investigation, on a real ICEYE dwell over Giza. Repairing any one leaves the other three.{' '}
          <a href={`${base}/archive/`}>The first investigation →</a>
        </p>
      </div>
      <div class="stat-row deep">
        {
          budget.map((b) => (
            <div class="stat">
              <span class="value">
                {b.value}
                <small>{b.unit}</small>
              </span>
              <span class="what">{b.what}</span>
              <span class="src">{b.src}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .home {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .claim {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 24px 48px;
    align-items: start;
    padding: 44px 0 34px;
    border-bottom: 1px solid var(--border);
  }
  .claim h2,
  .head h2 {
    font-family: var(--font-serif);
    font-size: 25px;
    font-weight: 500;
    line-height: 1.2;
    margin: 8px 0 10px;
  }
  .claim .prose {
    font-size: 15px;
  }
  .block {
    padding: 38px 0 6px;
  }
  .head {
    max-width: 780px;
    margin-bottom: 20px;
  }
  .sub {
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.6;
    color: var(--body);
  }
  .results {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .result {
    display: block;
    padding: 18px 20px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .result:hover {
    border-color: var(--border-strong);
    box-shadow: 0 2px 14px rgba(28, 40, 51, 0.07);
  }
  .result h3 {
    font-size: 15px;
    margin: 10px 0 10px;
  }
  .result p {
    font-family: var(--font-serif);
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--body);
    margin-top: 8px;
  }
  .mini-map {
    max-width: 340px;
  }
  .deep-band {
    margin-top: 48px;
    background: var(--deep);
    background-image: radial-gradient(90% 120% at 85% 0%, rgba(91, 143, 224, 0.1), transparent 60%);
    color: var(--panel-text);
    padding: 42px 0 46px;
  }
  .deep-band h2 {
    color: #eef3f7;
  }
  .deep-band .sub {
    color: var(--panel-muted);
  }
  .deep-band .sub a {
    color: var(--panel-text);
  }
  .tag.on-deep {
    color: var(--panel-muted);
    border-color: var(--panel-line);
  }
  .stat-row.deep {
    background: var(--panel-line);
    border-color: var(--panel-line);
  }
  .stat-row.deep .stat {
    background: var(--panel-bg);
  }
  .stat-row.deep .value {
    color: #eef3f7;
  }
  .stat-row.deep .value small,
  .stat-row.deep .src {
    color: var(--panel-faint);
  }
  .stat-row.deep .what {
    color: var(--panel-muted);
  }
  @media (max-width: 900px) {
    .home {
      padding: 0 16px;
    }
    .claim,
    .results {
      grid-template-columns: 1fr;
    }
  }
</style>
