---
import Doc from '../layouts/Doc.astro';
import DwellDiagram from '../components/DwellDiagram.astro';
import LineChart from '../components/LineChart.astro';
import RunDetails from '../components/RunDetails.astro';
import Term from '../components/Term.astro';
import Sci from '../components/Sci.astro';
import geo from '../../public/data/runs/p2_01_geometry.json';
import sees from '../../public/data/runs/p2_03_what_a_dwell_sees.json';
import imp from '../../public/data/runs/p2_04_chamber_imprint.json';
import bud from '../../public/data/runs/p2_05_budget.json';
import dep from '../../public/data/runs/p2_06_depth_is_frequency.json';
import chain from '../../public/data/runs/p2_07_whole_chain.json';
import pill from '../../public/data/runs/p2_08_pillars_and_boxes.json';
import vsens from '../../public/data/runs/p2_09_virtual_sensors.json';
import every from '../../public/data/runs/p2_11_every_way_in.json';
import realpass from '../../public/data/runs/p2_12_real_pass.json';
import gates from '../../public/data/runs/p2_13_gates.json';
import own from '../../public/data/runs/p2_14_own_lines.json';
import resp from '../../public/data/runs/p2_15_pair_response.json';
import khufu from '../../public/data/runs/p2_16_khufu_volume.json';
import plateau from '../../public/data/runs/p2_17_plateau_control.json';
import pulses from '../../public/data/runs/p2_18_echo_validation.json';
import known from '../../public/data/runs/p2_19_known_vibration.json';
import labKhafre from '../../public/data/runs/lab_khafre.json';
import survives from '../../public/data/runs/p2_21_what_survives.json';
import bench from '../../public/data/runs/p2_20_bench_gated.json';
import Boundary from '../components/Boundary.astro';
import { GATED_CODE } from '../data/credits';
import readers from '../../public/data/runs/p2_23_every_reader.json';
import onShaking from '../../public/data/runs/p2_24_gated_on_the_shaking.json';
import shaking from '../../public/data/runs/p2_22_one_shaking.json';
import passive from '../../public/data/runs/p1_04_ambient.json';
import echo from '../../public/data/runs/p1_03_scattered.json';
import bound from '../../public/data/runs/p2_25_information_bound.json';
import spectrum from '../../public/data/runs/p2_26_imprint_spectrum.json';
import requirement from '../../public/data/runs/p2_27_requirement.json';
import oracle from '../../public/data/runs/p2_29_oracle.json';
import Figure from '../components/Figure.astro';
import Ceiling from '../components/Ceiling.astro';
import Routes from '../components/Routes.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// ---- formatting
const SUP = '⁰¹²³⁴⁵⁶⁷⁸⁹';
const sup = (n: number) => String(n).replace('-', '⁻').replace(/\d/g, (d) => SUP[+d]);
const sci = (v: number, p = 1) => {
  const e = Math.floor(Math.log10(Math.abs(v)));
  const m = v / 10 ** e;
  return Math.abs(e) < 3 ? v.toPrecision(p + 1) : `${m.toFixed(p)} × 10${sup(e)}`;
};
const order = (v: number) => `10${sup(Math.round(Math.log10(v)))}`;
const um = (v: number) => v * 1e6;
const kms = (v: number) => v.toLocaleString('en-US', { maximumFractionDigits: 0 });
const pct = (v: number) => `${(v * 100).toFixed(0)}%`;

// ---- P2-01
const gz = geo.sites['giza-20250827'];
const sq = geo.sites['sacsayhuaman-20250822'];
const acquisitions: [string, string, string][] = [
  ['Satellite', gz.satellite, sq.satellite],
  ['Date', gz.collection_start.slice(0, 10), sq.collection_start.slice(0, 10)],
  ['Processed aperture', `${gz.aperture_s.toFixed(2)} s`, `${sq.aperture_s.toFixed(2)} s`],
  ['Incidence', `${gz.incidence_deg.toFixed(1)}°`, `${sq.incidence_deg.toFixed(1)}°`],
  ['Wavelength', `${(gz.wavelength_m * 100).toFixed(2)} cm`, `${(sq.wavelength_m * 100).toFixed(2)} cm`],
  ['Resolution, azimuth × slant', `${(gz.azimuth_resolution_m * 100).toFixed(1)} × ${(gz.slant_resolution_m * 100).toFixed(0)} cm`, `${(sq.azimuth_resolution_m * 100).toFixed(1)} × ${(sq.slant_resolution_m * 100).toFixed(0)} cm`],
  ['Platform, ground sweep, effective speed', `${kms(gz.speeds_m_s.platform)} · ${kms(gz.speeds_m_s.ground_sweep)} · ${kms(gz.speeds_m_s.effective)} m/s`, `${kms(sq.speeds_m_s.platform)} · ${kms(sq.speeds_m_s.ground_sweep)} · ${kms(sq.speeds_m_s.effective)} m/s`],
  ['Platform travel over the aperture', `${(gz.baseline_span_m / 1e3).toFixed(1)} km`, `${(sq.baseline_span_m / 1e3).toFixed(1)} km`],
  ['A look’s resolution × duration', `${(0.886 * gz.time_space_m_s).toFixed(2)} m s`, `${(0.886 * sq.time_space_m_s).toFixed(2)} m s`],
];

// ---- P2-03
const blk = sees.real.block;
const lt = (sees.motion.look_times_s as number[]);
const tc = lt[Math.floor(lt.length / 2)];
const tx = lt.map((t) => t - tc);
const rel = (a: number[]) => a.map((v) => um(v - a[Math.floor(a.length / 2)]));
const coh = sees.coherence;
const W = coh.look_s as number;
const lp = sees.lowpass.rows as { f_hz: number; recovered_gain: number; sinc_gain: number }[];
const fs = Array.from({ length: 301 }, (_, i) => 0.01 + i * 0.01);
const sinc = (x: number) => (x === 0 ? 1 : Math.sin(Math.PI * x) / (Math.PI * x));
const gr = sees.motion.ground;
const pt = sees.motion.point;
const gains = [
  { what: 'ordinary ground, simulated on the real geometry', cpx: gr.gain_complex, cse: gr.gain_complex_se, env: gr.gain_envelope, ese: gr.gain_envelope_se, par: gr.gain_paired },
  { what: 'ordinary ground, the real Giza image', cpx: blk.gain_complex, cse: blk.gain_complex_se, env: blk.gain_envelope, ese: blk.gain_envelope_se, par: blk.gain_paired },
  { what: 'a lone bright scatterer, simulated', cpx: pt.gain_complex, cse: pt.gain_complex_se, env: pt.gain_envelope, ese: pt.gain_envelope_se, par: pt.gain_paired },
];

// ---- P2-04
const cases = imp.cases as { case: string; vertical_velocity_m_s: number; frequency_hz: number; phase_speed_m_s: number; strain: number; imprint_los_velocity_m_s: number; imprint_over_motion: number; source: string }[];
const prof = imp.profile;
const conv = imp.convergence as { spacing_m: number; half_width_m: number; epicentre_uz_m: number }[];

// ---- P2-05
type Row = { case: string; target: string; imprint_m_s: number; a_min_m_s: number | null; shortfall: number | null; shake_needed_m_s: number | null; note: string };
const rows = bud.rows as Row[];
const targets = (bud.targets as { target: string }[]).map((t) => t.target);
const caseNames = cases.map((c) => c.case);
const cell = (c: string, t: string) => rows.find((r) => r.case === c && r.target === t)!;
const ground = cell(caseNames[0], targets[1]);
const bright = cell(caseNames[0], targets[2]);
const refl = cell(caseNames[0], targets[3]);
const chk = bud.check;

// ---- P2-06
const drow = dep.rows as { f_hz: number; depth_m: number; predicted_m: number; folded: boolean }[];
const mph = dep.metres_per_hz as number;
const fsamp = dep.pair_sampling_hz as number;
const fline = Array.from({ length: 321 }, (_, i) => i * 0.01);
const fold = (f: number) => mph * Math.abs(f - fsamp * Math.round(f / fsamp));
const prof6 = dep.profiles as Record<string, { depth_m: number; tomogram: number[] }>;
const zax = dep.depth_axis_m as number[];
const tones = dep.site_tones_m as Record<string, { label: string; f_hz: number; depth_m: number }>;

// ---- P2-07
const cfig = (f: string) => `${base}/data/runs/p2_07_whole_chain/${f}`;
const cg = chain.geometry;
const czmax = cg.depth_m[1] as number;
const [csx0, csx1] = cg.section_azimuth_m as number[];
const croom = { x: (100 * (-3 - csx0)) / (csx1 - csx0), w: (100 * 6) / (csx1 - csx0), y: (100 * 12) / czmax };
const sweep = chain.sweep as { gain: number; imprint_phase_rad: number; method_relative_difference: number; over_chamber: number; elsewhere: number }[];
const ccmp = chain.compare;
const noisyGround = cell(caseNames[1], targets[1]).shortfall as number;
const truckGround = cell(caseNames[3], targets[1]).shortfall as number;
const noisyRefl = cell(caseNames[1], targets[3]).shortfall as number;
const brightShort = bright.shortfall as number;
const reflShort = refl.shortfall as number;
const wholeMotion = Math.round((ground.a_min_m_s as number) / imp.cases[0].vertical_velocity_m_s);

// ---- P2-08
const pk = pill.sets.khafre;
const pfig = (f: string) => `${base}/data/runs/p2_08_pillars_and_boxes/${f}`;
const rep1 = pk.repeat_depth_m_shown as number;

// ---- P2-09
const vfig = (f: string) => `${base}/data/runs/p2_09_virtual_sensors/${f}`;
const vc = vsens.count;
const vst = vsens.stack as Record<'complex' | 'magnitude', { n: number[]; scatter_m_s: number[]; slope: number }>;
const vmap = vsens.maps.truth;
const vaspect = `${vmap.aspect_m[0].toFixed(0)} / ${vmap.aspect_m[1].toFixed(0)}`;
const halfLine = vst.magnitude.n.map((n) => um(vst.magnitude.scatter_m_s[0]) / Math.sqrt(n));

// ---- P2-11
const eA = every.A_penetration;
const eB = every.B_vibration;
const eC = every.C_between_passes;
const eBench = eA.rows[0];
const eClaim = eA.rows[2];
const eBands = eA.bands as { id: string; name: string; sand_penetration_m: number }[];
const heatBench = eC.rooms.bench.heat;
const smallLoads = ['tide', 'air', 'water'].map((k) => (eC.rooms.bench as Record<string, { imprint_m: number }>)[k].imprint_m);
const dB = (v: number) => Math.round(v).toLocaleString('en-US');
const sig2 = (v: number) => Number(v.toPrecision(2)).toLocaleString('en-US');

// ---- P2-13
type GSide = { exact_zero: number; within_one_step: number };
type GFeat = { case: string; mode: number; best_depth_m: number };
type GNew = { side: string; modes: number[]; planted_hz: number | null };
const gc = gates.counts as { real: number; twins: number[]; planted: number; desert: number; positions_per_image: number };
const gRuns = gates.runs as { real: number; twins: number[]; planted: number; desert: number };
const gg = gates.gate;
const gSpan = gates.pair_span_s as number;
const gModeHz = gg.mode_hz as number[];
const gSets = gates.sets as unknown as { cases: Record<string, { sides: Record<string, GSide> }> }[];
const gMean = (pick: (c: string) => boolean, key: keyof GSide) => {
  const v = gSets.flatMap((st) => Object.entries(st.cases).filter(([c]) => pick(c)).flatMap(([, r]) => Object.values(r.sides)));
  return v.reduce((a, x) => a + x[key], 0) / v.length;
};
const gZero = gMean((c) => c === 'real', 'exact_zero');
const gStep = gMean((c) => c === 'real', 'within_one_step');
const gZeroTwin = gMean((c) => c.startsWith('twin'), 'exact_zero');
const gFirst = gates.first_gate_windows as Record<string, number>;
const gFirstTwin = gc.twins.reduce((a, _, i) => a + gFirst[`twin${gates.manifest.params.twin_seeds[i]}`], 0) / gc.twins.length;
const gFeats = gates.features as unknown as GFeat[];
const gNew = gates.planted_new as unknown as GNew[];
const gZc = gates.depth_per_cycle_m as number;
const gRep = gates.repeat_m as number;
const gW = Math.round((gg.window_s as number) / (gg.pair_s as number));
const gAxis = Array.from({ length: gModeHz.length }, (_, i) => i + 1);
// set a little apart by case so that coincident positions stay visible; the real image drawn last, on top
const gGroups: [string, (c: string) => boolean, string, number][] = [
  ['motionless twins', (c) => c.startsWith('twin'), 'var(--lapis)', -0.18],
  ['open desert', (c) => c === 'desert', 'var(--ochre)', -0.06],
  ['planted vibrations', (c) => c === 'planted', 'var(--verdigris)', 0.06],
  ['the real image', (c) => c === 'real', 'var(--cinnabar)', 0.18],
];
const gDots = gGroups
  .map(([name, pick, color, dx]) => {
    const f = gFeats.filter((x) => pick(x.case)).sort((a, b) => a.mode - b.mode);
    return { name, x: f.map((x) => x.mode + dx), y: f.map((x) => x.best_depth_m), color, markers: true, width: 0 };
  })
  .filter((d) => d.x.length);
const gPlural = (n: number, one: string, many = `${one}s`) => `${n.toLocaleString('en-US')} ${n === 1 ? one : many}`;
const gatesVerdict =
  `With nothing moving and nothing inside, the two twins pass ${gc.twins.join(' and ')} positions (${gRuns.twins.join(' and ')} features); ` +
  `the real image passes ${gc.real} (${gPlural(gRuns.real, 'feature')}), and open desert in the same image ${gc.desert ? `${gc.desert} (${gPlural(gRuns.desert, 'feature')})` : 'none'}. ` +
  `With the vibrations planted, ${gates.planted_kept === gRuns.real ? 'the real image’s ' + (gRuns.real === 1 ? 'feature passes' : 'features pass') + ' again' : `${gates.planted_kept} of the real image’s features pass again`}` +
  (gNew.length
    ? `, and ${gNew.length === 1 ? 'one new feature' : `${gNew.length} new features`}: ${gNew.map((r) => `on the ${r.side.toLowerCase()} face${r.planted_hz ? `, where ${r.planted_hz} Hz was planted` : ''}, at mode ${r.modes.join(', ')}, which stands for ${r.modes.map((m) => (m / gg.window_s).toFixed(1)).join(', ')} Hz`).join('; ')}.`
    : ', and nothing new.');

// ---- P2-14
type OChange = { side: string; position: number; mode: number | null; in_stretch: boolean };
const oPos = own.positions as unknown as Record<string, Record<string, Record<string, number>>>;
const oSup = ['1', '2', '3', '4', '5'];
const oRows: [string, string, string][] = [
  ['the real image', 'wgs84', 'real'],
  ['a motionless twin', 'wgs84', 'twin101'],
  ['a motionless twin, other speckle', 'wgs84', 'twin102'],
  ['the real image, vibrations planted', 'wgs84', 'planted'],
  ['open desert, the same image', 'desert', 'real'],
];
const oW = oPos.wgs84;
const oSea = oPos.sea_level;
const oDesert = oPos.desert.real;
const oNothing = ['4', '5'].every((P) => Object.values(oW).every((c) => c[P] === 0) && oDesert[P] === 0);
const oTwin1 = (oW.twin101['1'] + oW.twin102['1']) / 2;
const oDepth = (own.depth_vs_mode as unknown as Record<string, { n: number; at_mode_depth: number; chance: number }>)['1'];
const oChanges = own.planted_changes as unknown as Record<string, Record<string, { new: OChange[]; lost: number }>>;
const oNew = Object.values(oChanges).flatMap((w) => Object.values(w).flatMap((c) => c.new));
const oLost = Object.values(oChanges).reduce((a, w) => a + Object.values(w).reduce((b, c) => b + c.lost, 0), 0);
const oNorthModes = [...new Set(oNew.filter((c) => c.in_stretch && c.side === 'North' && c.mode !== null).map((c) => c.mode as number))].sort((a, b) => a - b);
const oReturned = (own.planted_returned as unknown[]).length;
const oRate = own.doppler_rate_hz_s as number;
const oSpan = own.image_span_s as number;
const oSpread = Math.max(...Object.values(own.steering as Record<string, { zero_doppler_spread_s: number }>).map((s) => s.zero_doppler_spread_s));
const oFrameMs = (1000 * (gates.manifest.params.bank.k_leap_hz as number)) / oRate;
// ---- P2-15
type RRow = { v_m_s: number; f_hz: number; pair_amp_px: { range: number; azimuth: number }; boxcar_px: number; paired_amp_px: number; paired_boxcar_px: number; pair_share_of_present: number | null; image_over_boxcar: number | null; windows_passing: number; trace_width_ratio: number };
const rScenes = resp.scenes as unknown as Record<string, { rows: RRow[]; still_windows_passing: number }>;
const rRows = (sc: string, v: number) => rScenes[sc].rows.filter((r) => r.v_m_s === v && r.pair_amp_px.azimuth >= 1e-4).sort((a, b) => a.f_hz - b.f_hz);
const rSpan = (vals: (number | null)[]) => { const v = vals.filter((x): x is number => x !== null); return [Math.min(...v), Math.max(...v)]; };
const rImg = rSpan(rScenes.point.rows.map((r) => r.image_over_boxcar));
const rSharePt = rSpan(rScenes.point.rows.map((r) => r.pair_share_of_present));
const rShareTx = rSpan(rScenes.texture.rows.map((r) => r.pair_share_of_present).map((x) => (x === null ? null : x * 100)));
const rMaxPt2 = Math.max(...rScenes.point.rows.filter((r) => r.v_m_s === 0.002).map((r) => r.pair_amp_px.azimuth));
const rMaxTx2 = Math.max(...rScenes.texture.rows.filter((r) => r.v_m_s === 0.002).map((r) => r.pair_amp_px.azimuth));
const rPointWindows = rScenes.point.rows.reduce((acc, r) => acc + r.windows_passing, 0);
const rWidth = Math.max(...['point_on_clutter', 'texture'].flatMap((sc) => rScenes[sc].rows.filter((r) => r.pair_amp_px.azimuth >= 0.005).map((r) => r.trace_width_ratio)));
// ---- P2-16
type KStat = { voxels_with_score: number; mean_score_in_chambers: number | null; mean_score_same_depths_elsewhere: number | null; chamber_voxels_with_score: number; chamber_voxels: number };
const kStats = khufu.stats as unknown as Record<string, KStat>;
const kRes = khufu.results as unknown as Record<string, { supported_positions: Record<string, number> }>;
const kR1 = kStats.real_p1;
const kT1 = kStats.twin101_p1;
const kLift = (st: KStat) => (st.mean_score_in_chambers ?? 0) - (st.mean_score_same_depths_elsewhere ?? 0);
const kHigher = kLift(kR1) > 0.05;
const kLikeCopy = Math.abs(kRes.real.supported_positions['1'] - kRes.twin101.supported_positions['1']) < 0.5 * kRes.real.supported_positions['1'];
const kFmt = (v: number | null) => (v === null ? '–' : v.toFixed(2));
const kP = plateau.supported_positions as unknown as Record<string, number>;
const kPV = (plateau.stats as unknown as Record<string, { voxels_with_score: number }>).real_p1.voxels_with_score;
const kHeading = `Across the whole Great Pyramid, the gated reconstruction’s scores ${kHigher ? 'run higher' : 'are no higher'} inside the surveyed chambers than at the same depths elsewhere${kLikeCopy ? ', and a motionless copy draws a volume of the same kind' : ''}`;
// ---- P2-18, P2-19
const eRes = pulses.resolution as { azimuth_m: number; azimuth_theory_m: number; range_m: number; range_theory_m: number };
const eSl = pulses.slice_is_stretch as { corr_same: number; corr_mirror: number | null }[];
const eSame = eSl.map((x) => x.corr_same);
const eMirror = Math.max(...eSl.filter((x) => x.corr_mirror !== null).map((x) => x.corr_mirror as number));
const ePairs = pulses.pairs_pulses_vs_injection as { v_m_s: number; f_hz: number; pulses_px: number; injection_px: number }[];
const eBig = ePairs.filter((x) => Math.max(x.pulses_px, x.injection_px) >= 0.02);
type KRow = { v_m_s: number; f_hz: number; tracker: { recovered_m_s: number; truth_look_average_m_s: number; se_m_s: number } | null; pipeline_shift_amp_px?: { azimuth: number }; passes_at_reflector: Record<string, number>; passing_positions: Record<string, Record<string, number[]>> };
const kRows = Object.entries(known.results as unknown as Record<string, KRow>);
const kMoving = kRows.filter(([, r]) => r.v_m_s > 0);
const kElsewhere = kRows.flatMap(([, r]) => Object.values(r.passing_positions['1']).map((v) => v.length));
// ---- P2-20: the known bench through the gated pipeline
type BChange = { positions_changed: number; positions_changed_near: number; passes_flipped: number; near_changes_at_chamber_depth: number; max_score_change: number };
type BRow = { boost: number | null; supported_positions: Record<string, number>; values_changed: number; p1?: BChange };
const bRes = bench.results as unknown as Record<string, BRow>;
const bShare = bench.near_share as number;
const bGathers = (r?: BChange) => !!r && r.positions_changed_near >= 5 && r.positions_changed_near > 3 * bShare * r.positions_changed;
const bFirst = ['with', 'boost_1e4', 'boost_1e8'].find((k) => bGathers(bRes[k].p1));
const bRows: [string, string][] = [
  ['without', 'without the chamber'],
  ['with', 'with it, at its real level'],
  ['null', 'a random perturbation of that size'],
  ['boost_1e4', 'its imprint ×10⁴'],
  ['boost_1e8', 'its imprint ×10⁸'],
];
const bV8 = (bench.imprint_los_velocity_boost_1e8_m_s as number) * 1e3;
const bJump = Math.max(bRes.with.p1!.max_score_change, bRes.null.p1!.max_score_change);
const bHeading = bFirst === undefined
  ? 'Over the known chamber, the gated pipeline’s picture changes no more with the chamber than with random noise of its size, even boosted a hundred million times'
  : bFirst === 'with'
    ? 'Over the known chamber, the gated pipeline’s picture changes where the chamber is'
    : `Over the known chamber, the gated pipeline’s picture changes over it only once its imprint is boosted ${bFirst === 'boost_1e4' ? 'ten thousand' : 'a hundred million'} times`;
// ---- P2-21: what survives a change of pass or of lines
type SCmp = { passing: number[]; both: number; chance_both: number; ratio: number; same_depth_share: number; same_depth_chance: number; same_depth_chance_p95: number };
const sv = survives.results as unknown as Record<string, Record<string, SCmp>>;
const svL = sv.ew22_ns22.real;
const svP = sv.ew22_ew25.real;
const svC = sv.ew22_ew25.ew22_vs_copy;
const svAbove = (r: SCmp) => r.ratio > 1.5 && r.same_depth_share > r.same_depth_chance_p95;
const svBeyondCopy = (r: SCmp) => r.ratio > svC.ratio && r.same_depth_share > svC.same_depth_share;
const svHeading =
  svAbove(svP) && svBeyondCopy(svP)
    ? 'Across Khafre, what the gated reconstruction draws survives a change of pass beyond chance'
    : svAbove(svP)
      ? 'Across Khafre, two passes agree beyond chance, but no more than an image agrees with its own motionless copy'
      : 'Across Khafre, what the gated reconstruction draws does not survive a change of pass';
const svRows: [string, SCmp][] = [
  ['lines laid east–west, then north–south (2022)', svL],
  ['the 2022 pass, then the 2025 pass (east–west)', svP],
  ['for scale: the 2022 image, then its motionless copy', svC],
];
const svPct = (x: number) => `${Math.round(x * 100)}%`;
// ---- P2-24: the gated reconstruction on the one shaking
type R24 = { force_n: number; supported_positions: Record<string, number>; p1?: { positions_changed: number; positions_changed_near: number; max_score_change: number } };
const r24 = onShaking.results as unknown as Record<string, R24>;
// the record's own tags for the two forces, strongest first
