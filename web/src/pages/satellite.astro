const longLen = Math.max(...Object.values(sp.long).map((l) => l.record_s));
const dyn7 = sp.static.dynamic_over_static;
const staticLine = (f: number) => (2 * Math.PI * f * (imp.hv as number) * (imp.imprint_peak_los_per_strain_m as number)) / (imp.rayleigh_speed_m_s as number);
const fStatic = Array.from({ length: 25 }, (_, i) => 6 + i);
// P2-27: what one image would need, conditionally
