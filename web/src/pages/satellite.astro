---
import Doc from '../layouts/Doc.astro';
import DwellDiagram from '../components/DwellDiagram.astro';
import LineChart from '../components/LineChart.astro';
import RunDetails from '../components/RunDetails.astro';
import Term from '../components/Term.astro';
import Sci from '../components/Sci.astro';
import geo from '../../public/data/runs/p2_01_geometry.json';
import sees from '../../public/data/runs/p2_03_what_a_dwell_sees.json';
import imp from '../../public/data/runs/p2_04_chamber_imprint.json';
import bud from '../../public/data/runs/p2_05_budget.json';
import dep from '../../public/data/runs/p2_06_depth_is_frequency.json';
import chain from '../../public/data/runs/p2_07_whole_chain.json';
import pill from '../../public/data/runs/p2_08_pillars_and_boxes.json';
import vsens from '../../public/data/runs/p2_09_virtual_sensors.json';
import every from '../../public/data/runs/p2_11_every_way_in.json';
import realpass from '../../public/data/runs/p2_12_real_pass.json';
import passive from '../../public/data/runs/p1_04_ambient.json';
import echo from '../../public/data/runs/p1_03_scattered.json';
import Figure from '../components/Figure.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// ---- formatting
const SUP = '⁰¹²³⁴⁵⁶⁷⁸⁹';
const sup = (n: number) => String(n).replace('-', '⁻').replace(/\d/g, (d) => SUP[+d]);
const sci = (v: number, p = 1) => {
  const e = Math.floor(Math.log10(Math.abs(v)));
  const m = v / 10 ** e;
  return Math.abs(e) < 3 ? v.toPrecision(p + 1) : `${m.toFixed(p)} × 10${sup(e)}`;
};
const order = (v: number) => `10${sup(Math.round(Math.log10(v)))}`;
const um = (v: number) => v * 1e6;
const kms = (v: number) => v.toLocaleString('en-US', { maximumFractionDigits: 0 });
const pct = (v: number) => `${(v * 100).toFixed(0)}%`;

// ---- P2-01
const gz = geo.sites['giza-20250827'];
const sq = geo.sites['sacsayhuaman-20250822'];
const acquisitions: [string, string, string][] = [
  ['Satellite', gz.satellite, sq.satellite],
  ['Date', gz.collection_start.slice(0, 10), sq.collection_start.slice(0, 10)],
  ['Processed aperture', `${gz.aperture_s.toFixed(2)} s`, `${sq.aperture_s.toFixed(2)} s`],
  ['Incidence', `${gz.incidence_deg.toFixed(1)}°`, `${sq.incidence_deg.toFixed(1)}°`],
  ['Wavelength', `${(gz.wavelength_m * 100).toFixed(2)} cm`, `${(sq.wavelength_m * 100).toFixed(2)} cm`],
  ['Resolution, azimuth × slant', `${(gz.azimuth_resolution_m * 100).toFixed(1)} × ${(gz.slant_resolution_m * 100).toFixed(0)} cm`, `${(sq.azimuth_resolution_m * 100).toFixed(1)} × ${(sq.slant_resolution_m * 100).toFixed(0)} cm`],
  ['Platform, ground sweep, effective speed', `${kms(gz.speeds_m_s.platform)} · ${kms(gz.speeds_m_s.ground_sweep)} · ${kms(gz.speeds_m_s.effective)} m/s`, `${kms(sq.speeds_m_s.platform)} · ${kms(sq.speeds_m_s.ground_sweep)} · ${kms(sq.speeds_m_s.effective)} m/s`],
  ['Platform travel over the aperture', `${(gz.baseline_span_m / 1e3).toFixed(1)} km`, `${(sq.baseline_span_m / 1e3).toFixed(1)} km`],
  ['A look’s resolution × duration', `${(0.886 * gz.time_space_m_s).toFixed(2)} m s`, `${(0.886 * sq.time_space_m_s).toFixed(2)} m s`],
];

// ---- P2-03
const blk = sees.real.block;
const lt = (sees.motion.look_times_s as number[]);
const tc = lt[Math.floor(lt.length / 2)];
const tx = lt.map((t) => t - tc);
const rel = (a: number[]) => a.map((v) => um(v - a[Math.floor(a.length / 2)]));
const coh = sees.coherence;
const W = coh.look_s as number;
const lp = sees.lowpass.rows as { f_hz: number; recovered_gain: number; sinc_gain: number }[];
const fs = Array.from({ length: 301 }, (_, i) => 0.01 + i * 0.01);
const sinc = (x: number) => (x === 0 ? 1 : Math.sin(Math.PI * x) / (Math.PI * x));
const gr = sees.motion.ground;
const pt = sees.motion.point;
const gains = [
  { what: 'ordinary ground, simulated on the real geometry', cpx: gr.gain_complex, cse: gr.gain_complex_se, env: gr.gain_envelope, ese: gr.gain_envelope_se, par: gr.gain_paired },
  { what: 'ordinary ground, the real Giza image', cpx: blk.gain_complex, cse: blk.gain_complex_se, env: blk.gain_envelope, ese: blk.gain_envelope_se, par: blk.gain_paired },
  { what: 'a lone bright scatterer, simulated', cpx: pt.gain_complex, cse: pt.gain_complex_se, env: pt.gain_envelope, ese: pt.gain_envelope_se, par: pt.gain_paired },
];

// ---- P2-04
const cases = imp.cases as { case: string; vertical_velocity_m_s: number; frequency_hz: number; phase_speed_m_s: number; strain: number; imprint_los_velocity_m_s: number; imprint_over_motion: number; source: string }[];
const prof = imp.profile;
const conv = imp.convergence as { spacing_m: number; half_width_m: number; epicentre_uz_m: number }[];

// ---- P2-05
type Row = { case: string; target: string; imprint_m_s: number; a_min_m_s: number | null; shortfall: number | null; shake_needed_m_s: number | null; note: string };
const rows = bud.rows as Row[];
const targets = (bud.targets as { target: string }[]).map((t) => t.target);
const caseNames = cases.map((c) => c.case);
const cell = (c: string, t: string) => rows.find((r) => r.case === c && r.target === t)!;
const ground = cell(caseNames[0], targets[1]);
const bright = cell(caseNames[0], targets[2]);
const refl = cell(caseNames[0], targets[3]);
const chk = bud.check;

// ---- P2-06
const drow = dep.rows as { f_hz: number; depth_m: number; predicted_m: number; folded: boolean }[];
const mph = dep.metres_per_hz as number;
const fsamp = dep.pair_sampling_hz as number;
const fline = Array.from({ length: 321 }, (_, i) => i * 0.01);
const fold = (f: number) => mph * Math.abs(f - fsamp * Math.round(f / fsamp));
const prof6 = dep.profiles as Record<string, { depth_m: number; tomogram: number[] }>;
const zax = dep.depth_axis_m as number[];
const tones = dep.site_tones_m as Record<string, { label: string; f_hz: number; depth_m: number }>;

// ---- P2-07
const cfig = (f: string) => `${base}/data/runs/p2_07_whole_chain/${f}`;
const cg = chain.geometry;
const czmax = cg.depth_m[1] as number;
const [csx0, csx1] = cg.section_azimuth_m as number[];
const croom = { x: (100 * (-3 - csx0)) / (csx1 - csx0), w: (100 * 6) / (csx1 - csx0), y: (100 * 12) / czmax };
const sweep = chain.sweep as { gain: number; imprint_phase_rad: number; method_relative_difference: number; over_chamber: number; elsewhere: number }[];
const ccmp = chain.compare;
const noisyGround = cell(caseNames[1], targets[1]).shortfall as number;
const truckGround = cell(caseNames[3], targets[1]).shortfall as number;
const noisyRefl = cell(caseNames[1], targets[3]).shortfall as number;
const brightShort = bright.shortfall as number;
const reflShort = refl.shortfall as number;
const wholeMotion = Math.round((ground.a_min_m_s as number) / imp.cases[0].vertical_velocity_m_s);

// ---- P2-08
const pk = pill.sets.khafre;
const pfig = (f: string) => `${base}/data/runs/p2_08_pillars_and_boxes/${f}`;
const rep1 = pk.repeat_depth_m_shown as number;

// ---- P2-09
const vfig = (f: string) => `${base}/data/runs/p2_09_virtual_sensors/${f}`;
const vc = vsens.count;
const vst = vsens.stack as Record<'complex' | 'magnitude', { n: number[]; scatter_m_s: number[]; slope: number }>;
const vmap = vsens.maps.truth;
const vaspect = `${vmap.aspect_m[0].toFixed(0)} / ${vmap.aspect_m[1].toFixed(0)}`;
const halfLine = vst.magnitude.n.map((n) => um(vst.magnitude.scatter_m_s[0]) / Math.sqrt(n));

// ---- P2-11
const eA = every.A_penetration;
const eB = every.B_vibration;
const eC = every.C_between_passes;
const eBench = eA.rows[0];
const eClaim = eA.rows[2];
const eBands = eA.bands as { id: string; name: string; sand_penetration_m: number }[];
const heatBench = eC.rooms.bench.heat;
const smallLoads = ['tide', 'air', 'water'].map((k) => (eC.rooms.bench as Record<string, { imprint_m: number }>)[k].imprint_m);
const dB = (v: number) => Math.round(v).toLocaleString('en-US');
const sig2 = (v: number) => Number(v.toPrecision(2)).toLocaleString('en-US');
---
<Doc
  title="The satellite over the same ground"
  kicker="From orbit · why one radar image cannot"
  current="satellite"
  lede="Here the real ICEYE pass over Giza is simulated, pixel by pixel, over ground whose chambers and motion are known, and checked on its real image. The answer is no, for three reasons that do not depend on one another: one image cannot see ordinary ground move, a chamber barely changes how the ground moves, and the published depth is only the frequency of the motion. Every other route from a buried room to a radar is closed as well."
  state="status · answered · 28 September 2026 · simulated on the real Giza geometry, checked on its real image"
  index={[
    { id: 'verdict', label: 'The verdict' },
    { id: 'questions', label: 'Four questions' },
    { id: 'geometry', label: 'The real geometry' },
    { id: 'blind', label: 'What one dwell sees' },
    { id: 'imprint', label: 'The chamber’s imprint' },
    { id: 'budget', label: 'The budget' },
    { id: 'depth', label: 'Depth is frequency' },
    { id: 'chain', label: 'The whole chain' },
    { id: 'pillars', label: 'Pillars and boxes' },
    { id: 'sensors', label: 'Virtual sensors' },
    { id: 'every', label: 'Every other route' },
    { id: 'real', label: 'The real pass' },
    { id: 'rescue', label: 'What could rescue it' },
    { id: 'record', label: 'Corrections' },
  ]}
>
  <section id="verdict">
    <h2>One radar image cannot find a chamber, for three independent reasons</h2>
    <div class="stat-row">
      <div class="stat"><span class="value">{pct(blk.gain_complex)}</span><span class="what">of a stretch of real ground’s motion recovered by registering one image’s looks against each other, as every single-image method does</span><span class="src">P2-03 · the real Giza image</span></div>
      <div class="stat"><span class="value"><Sci v={imp.cases[0].imprint_over_motion} /></span><span class="what">the fraction of the ground’s own motion a 6 m chamber 15 m down changes, as a microseism passes</span><span class="src">P2-04 · the lab’s solver</span></div>
      <div class="stat"><span class="value">{order(ground.shortfall!)}<small>×</small></span><span class="what">short: the smallest imprint a dwell could detect on the plateau, against the imprint there is ({order(bright.shortfall!)} on a bright scatterer)</span><span class="src">P2-05 · every advantage allowed</span></div>
      <div class="stat"><span class="value">{mph.toFixed(2)}<small>m/Hz</small></span><span class="what">of published “depth” per hertz of ground motion, whatever lies below: the depth axis is a frequency axis</span><span class="src">P2-06 · the published focusing</span></div>
    </div>
    <p class="sub">
      Each is sufficient alone. The first is about the estimator: <Term k="look">looks</Term> cut from one image share their
      spectrum sample for sample, so correlating them cannot see motion. The second is about physics: ambient waves are
      kilometres long and strain the rock around a chamber almost uniformly. The third is about the method’s algebra: its
      steering grows with time, so its focusing is a Fourier transform over time. The measured record from the real
      acquisitions (<a href={`${base}/archive/`}>the first investigation</a>) agrees, and three of its readings are corrected
      below.
    </p>
  </section>

  <section id="questions">
    <h2>A satellite can measure a bright target shaking, not the ground trembling, and perfect measurements would not show a chamber</h2>
    <div class="grid-2">
      <div class="note-card">
        <span class="tag measured">measured · 2026 papers, P2-03</span>
        <h3>Can a satellite measure vibration from one pass?</h3>
        <p>Yes, for bright, isolated targets that move a lot: in 2026, corner reflectors on shakers and a steel footbridge
        were measured from orbit at {(eB.smallest_measured_m_s * 1e3).toFixed(2)} mm/s and up, to about 1 mm/s. Not for ordinary
        ground. In one image, a patch of ground’s motion is nearly invisible to the looks ({pct(blk.gain_complex)} recovered on the
        real Giza image), and Giza’s trembling is {sig2(eB.measured_over_trembling)} times below the
        smallest motion ever measured from orbit. The 77 µm/s once quoted here was the scatter of a reading that does not respond
        to the ground’s motion, not a sensitivity.</p>
      </div>
      <div class="note-card">
        <span class="tag simulated">simulated · P2-06, P1-04</span>
        <h3>If every pixel’s vibration were known perfectly, would it show a chamber?</h3>
        <p>Not by the published method: its depth is the frequency of the motion, so given the exact motion at every pixel it
        draws the same picture over rock and over a chamber. Not by proper seismic imaging in one pass either: the ground’s
        trembling comes in waves kilometres long, too coarse to outline a room, and a pass lasts {gz.aperture_s.toFixed(1)} s.
        Even with short waves, perfect instruments on the ground and the rock known exactly, passive imaging shows the chamber
        no brighter than its surroundings after a minute of recording
        ({(passive.score.contrast_vs_record as { record_s: number; contrast: number }[]).find((r) => r.record_s === 60)!.contrast.toFixed(1)}×),{' '}
        {(passive.score.contrast_vs_record as { record_s: number; contrast: number }[]).find((r) => r.record_s === 3600)!.contrast.toFixed(1)}× after
        an hour, and never 3×.</p>
      </div>
      <div class="note-card">
        <span class="tag simulated">simulated · P2-09, P2-07</span>
        <h3>Isn’t a million virtual seismometers better than a few real ones?</h3>
        <p>Only if they hear. Made into {vsens.sensors.n.toLocaleString('en-US')} virtual sensors and shaken by a wave put into the
        image, they recover {pct(vsens.gains.complex)} of it read the published way. Averaging deaf sensors gives a precise zero.
        Where magnitudes hear a fifth, the chamber would need <Sci v={vsens.count.needed_for_chamber} p={0} /> sensors over it; the
        whole image holds <Sci v={vsens.count.in_image} p={0} />. Over the chamber, one pass’s reading wanders
        {' '}{sig2(ccmp.satellite_rms_m_s / ccmp.seismometer_rms_m_s)} times more than a real seismometer
        records there.</p>
      </div>
      <div class="note-card">
        <span class="tag simulated">simulated · P1-02 to P1-05, P2-03</span>
        <h3>Seismic instruments find the chamber; why can’t the satellite?</h3>
        <p>The ones that find it make their own waves. A hammer blow sends a sharp wave about {Math.round((imp.manifest.params.vs as number) / (echo.manifest.params.f0_hz as number))} m long,
        timed exactly, and instruments pressed against the ground record its echo within {Math.round((echo.manifest.params.record_s as number) * 1000)} ms: the
        chamber comes back {echo.score.contrast.toFixed(0)}× brighter than its surroundings. Listening to the ground’s own trembling instead works
        only weakly, even with perfect instruments ({passive.score.image_contrast_ensemble.toFixed(1)}× with unlimited listening). A satellite has no hammer,
        listens for {gz.aperture_s.toFixed(1)} s, cannot hear ordinary ground tremble, and its looks follow only motion slower than about a third of a hertz,
        whose waves are kilometres long.</p>
      </div>
    </div>
  </section>

  <section id="geometry">
    <h2>The real dwell has three speeds, and the simulator now has all three</h2>
    <p class="sub">
      A <Term k="dwell">Spotlight Dwell</Term> holds the beam on Giza for {gz.aperture_s.toFixed(1)} s. The platform moves at
      {' '}{kms(gz.speeds_m_s.platform)} m/s, the image’s rows sweep the ground at {kms(gz.speeds_m_s.ground_sweep)} m/s,
      and the Doppler history runs at {kms(gz.speeds_m_s.effective)} m/s, their geometric mean to
      {' '}{Math.abs((gz.veff2_over_vs_vg - 1) * 1e6).toFixed(0)} parts per million. The first simulator used one speed and put the
      Doppler rate {Math.abs(gz.flat_earth_rate_error.with_ground_speed * 100).toFixed(0)}% off. Every second of aperture is
      also a change of viewing direction, and a look’s resolution times its duration is fixed by the orbit: a
      {' '}{gz.looks[3].duration_s} s look resolves {gz.looks[3].resolution_m.toFixed(2)} m, a 0.25 s look {gz.looks[0].resolution_m.toFixed(1)} m.
      Looks are cut from the image’s Doppler band, and each Doppler frequency is a moment of the pass: the band sweeps by
      {' '}{Math.abs(gz.doppler_rate_hz_s).toLocaleString('en-US', { maximumFractionDigits: 0 })} Hz every second, so slicing the band in
      frequency is slicing the {gz.aperture_s.toFixed(1)} s in time, and a slice half the band wide averages
      {' '}{(gz.aperture_s / 2).toFixed(1)} s of whatever the ground did.
    </p>
    <DwellDiagram />
    <table class="data">
      <thead><tr><th></th><th>Giza</th><th>Sacsayhuamán</th></tr></thead>
      <tbody>{acquisitions.map((r) => <tr><td>{r[0]}</td><td class="num">{r[1]}</td><td class="num">{r[2]}</td></tr>)}</tbody>
    </table>
    <p class="note">
      Read from each product’s metadata into <code>sites/acquisitions/</code>. On this geometry the synthesizer’s point
      response is {(gz.synthetic.impulse_width_azimuth_m * 100).toFixed(2)} × {(gz.synthetic.impulse_width_slant_m * 100).toFixed(1)} cm
      as predicted, and a target receding at 2 mm/s moves {gz.synthetic.azimuth_shift_m.toFixed(3)} m in azimuth, read back as{' '}{(gz.synthetic.recovered_speed_m_s * 1e3).toFixed(3)} mm/s. The earlier “168 km” was the span of one bank’s sub-aperture
      centres ({(gz.reference_bank_centre_span_m / 1e3).toFixed(1)} km), not the platform’s travel.
    </p>
    <RunDetails manifest={geo.manifest} />
  </section>

  <section id="blind">
    <h2>Looks cut from one image cannot see ordinary ground move</h2>
    <p class="sub">
      Every single-image method, published or ours, reads motion by registering one image’s looks against each other. Two
      such looks share the spectrum they overlap, sample for sample, so their cross-spectrum is real and non-negative and
      their correlation locks at zero, whatever the ground does. For natural ground, whose <Term k="speckle">speckle</Term> is
      independent in every Doppler bin, motion shared by a patch leaves the image’s statistics exactly unchanged. Here a 20 m
      stretch of the real Giza image is made to sway at 2 mm/s, and read three ways.
    </p>
    <div class="grid-2 charts">
      <LineChart
        directLabels={false}
        title="Fig. S1 · A block of the real Giza image swaying at 2 mm/s, read from one image and against its motionless twin"
        series={[
          { name: 'the motion put in', x: tx, y: rel(blk.injected_absolute as number[]), color: 'var(--text)', width: 1.5 },
          { name: 'against the twin (simulation only)', x: tx, y: rel(blk.paired as number[]), color: 'var(--ochre)', dash: '4 3', markers: true },
          { name: 'one image, magnitudes', x: tx, y: (blk.envelope as number[]).map(um), color: 'var(--verdigris)', markers: true },
          { name: 'one image, complex (published, R4)', x: tx, y: (blk.complex as number[]).map(um), color: 'var(--cinnabar)', markers: true },
        ]}
        xLabel="look time from the reference look, s"
        yLabel="line-of-sight velocity, µm/s"
        zeroLine
        caption={`Relative to the reference look. Complex registration recovers ${pct(blk.gain_complex)} ± ${pct(blk.gain_complex_se)}, magnitudes ${pct(blk.gain_envelope)} ± ${pct(blk.gain_envelope_se)}; the motion is in the data (${pct(blk.gain_paired)} against the twin).`}
      />
      <LineChart
        directLabels={false}
        title="Fig. S2 · The first investigation’s coherence curve is the looks’ overlap"
        series={[
          { name: '1 − Δ/W, the shared spectrum', x: coh.delta_s as number[], y: coh.overlap as number[], color: 'var(--muted)', width: 1.4 },
          { name: 'simulated desert, no decorrelation', x: coh.delta_s as number[], y: coh.simulated as number[], color: 'var(--verdigris)', markers: true, dash: '3 3' },
          { name: 'R9, measured on the real image', x: coh.r9_measured.delta_s as number[], y: coh.r9_measured.coherence as number[], color: 'var(--lapis)', markers: true, dash: '1 4' },
        ]}
        xLabel="separation between looks, s"
        yLabel="coherence"
        caption={`Looks ${W} s wide. The real crop’s own power spectrum reproduces its measured coherence to within a billionth: R9 measured the looks, not the ground.`}
      />
    </div>
    <div class="grid-2 charts">
      <LineChart
        directLabels={false}
        title="Fig. S3 · A look averages motion over its duration"
        series={[
          { name: 'sinc(f W), a boxcar average', x: fs, y: fs.map((f) => sinc(f * W)), color: 'var(--muted)', width: 1.4 },
          { name: 'a bright point, recovered', x: lp.map((r) => r.f_hz), y: lp.map((r) => r.recovered_gain), color: 'var(--verdigris)', markers: true },
        ]}
        xLabel="frequency of the motion, Hz"
        yLabel="gain"
        zeroLine
        caption={`${W} s looks pass little above 0.3 Hz. The first investigation’s R7 injected at 1, 2 and 3 Hz, where a bright point comes back at ${lp.filter((r) => r.f_hz >= 1).map((r) => pct(Math.abs(r.recovered_gain))).join(', ')}.`}
      />
      <div class="note-card">
        <span class="tag simulated">simulated and real · P2-03</span>
        <h3>What each way of reading recovers</h3>
        <table class="data compact">
          <thead><tr><th></th><th>complex</th><th>magnitudes</th><th>twin</th></tr></thead>
          <tbody>
            {gains.map((g) => <tr><td>{g.what}</td><td class="num">{pct(g.cpx)} ± {pct(g.cse)}</td><td class="num">{pct(g.env)} ± {pct(g.ese)}</td><td class="num">{pct(g.par)}</td></tr>)}
          </tbody>
        </table>
        <p>
          Magnitudes catch what is point-like in the ground, more on the real plateau than in simulated speckle; a lone bright
          scatterer’s envelope follows its motion in full. “Twin” reads each look against the same look of the motionless
          scene, which only a simulation has: it shows the motion was there to be seen.
        </p>
      </div>
    </div>
    <RunDetails manifest={sees.manifest} />
  </section>

  <section id="imprint">
    <h2>A chamber changes the ground’s own motion by less than a ten-thousandth of it</h2>
    <p class="sub">
      Whatever a satellite could use to find a chamber passively would have to be its <Term k="imprint">imprint</Term>: the
      difference it makes to how the surface moves. Ambient waves are far longer than the chamber and its depth, so the rock
      around it is strained almost uniformly and almost statically. The lab’s solver answers the static question directly:
      load the rock with a uniform horizontal stress, open the chamber, and let the ground settle.
    </p>
    <div class="grid-2 charts">
      <LineChart
        directLabels={false}
        title="Fig. S4 · The surface over a 6 m chamber 15 m down, in rock under 1 MPa of horizontal tension"
        series={[
          { name: 'the lab’s solver', x: prof.x_m as number[], y: (prof.solver_uz_m as number[]).map(um), color: 'var(--verdigris)', width: 2 },
          { name: 'Eshelby’s void, Okada’s point sources', x: prof.x_m as number[], y: (prof.analytic_uz_m as number[]).map(um), color: 'var(--lapis)', dash: '5 3' },
        ]}
        xLabel="distance from above the chamber, m"
        yLabel="vertical displacement, µm"
        zeroLine
        caption={`Without the chamber nothing moves. On a 0.5 m grid the epicentre sinks ${Math.abs(um(conv[2].epicentre_uz_m)).toFixed(1)} µm against ${Math.abs(um(conv[0].epicentre_uz_m)).toFixed(1)} µm on 1 m; domains from 100 to 180 m wide agree to four digits. The analytic curve is a point sphere of equal volume.`}
      />
      <div class="note-card">
        <span class="tag simulated">simulated · P2-04</span>
        <h3>The imprint on the line-of-sight velocity</h3>
        <table class="data compact">
          <thead><tr><th>the ground’s motion</th><th>moves at</th><th>imprint</th></tr></thead>
          <tbody>
            {cases.map((c) => <tr><td>{c.case}</td><td class="num"><Sci v={um(c.vertical_velocity_m_s)} /> µm/s</td><td class="num"><Sci v={um(c.imprint_los_velocity_m_s)} /> µm/s</td></tr>)}
          </tbody>
        </table>
        <p>
          A passing <Term k="rayleigh">Rayleigh wave</Term> strains the ground by its horizontal-to-vertical ratio times its
          speed of motion over its phase speed, whatever its frequency, so the imprint is a fixed fraction of the motion for a
          given wave speed: <Sci v={imp.cases[0].imprint_over_motion} /> for microseisms. The truck is only a guide: at 15 Hz the
          waves are 110 m long, not long compared with the depth.
        </p>
      </div>
    </div>
    <RunDetails manifest={imp.manifest} />
  </section>

  <section id="budget">
    <h2>Allowing every advantage, one dwell falls short by ten thousand to a hundred million</h2>
    <p class="sub">
      The smallest imprint a dwell could detect, from what P2-03 measured: every one of its independent looks counted as a
      full measurement, a 3-sigma threshold, the look’s gain at the imprint’s frequency, and the best tracker for each
      target. Under Giza’s microseisms that is {um(ground.a_min_m_s!).toFixed(0)} µm/s on the plateau’s own texture,
      {' '}{um(bright.a_min_m_s!).toFixed(0)} µm/s on a bright scatterer directly above the chamber, and {um(refl.a_min_m_s!).toFixed(0)} µm/s
      on a corner reflector that no archive image contains, against an imprint of <Sci v={um(ground.imprint_m_s)} /> µm/s. For the
      plateau the ground would have to shake at {ground.shake_needed_m_s!.toFixed(0)} m/s, beyond the strongest earthquakes
      recorded, for the whole dwell.
    </p>
    <table class="data">
      <thead><tr><th>short by</th>{caseNames.map((c) => <th>{c}</th>)}</tr></thead>
      <tbody>
        {targets.map((t) => (
          <tr><td>{t}</td>{caseNames.map((c) => { const r = cell(c, t); return <td class="num">{r.shortfall === null ? 'no response' : order(r.shortfall)}</td>; })}</tr>
        ))}
      </tbody>
    </table>
    <p class="note">
      The threshold is checked by simulation: without motion the bright scatterer’s fitted sway scatters by
      {' '}{um(chk.null_rms_m_s).toFixed(0)} µm/s against the {um(chk.predicted_sigma_m_s).toFixed(0)} µm/s the formula uses, and a sway at
      the threshold is found in {pct(chk.detected_fraction)} of {chk.null_fits_m_s.length} realisations at a 5% false-alarm rate.
      Motion at 1–3 Hz needs 250 ms looks, resolving 4 m; the truck needs 33 ms looks, resolving 33 m, during its few seconds.
    </p>
    <RunDetails manifest={bud.manifest} />
  </section>

  <section id="depth">
    <h2>The published depth is the frequency of the motion: {mph.toFixed(2)} m per hertz</h2>
    <p class="sub">
      The published focusing projects each patch’s trajectory on a steering wave whose wavenumber grows with the platform’s
      offset, and on a dwell the offset grows steadily with time. So the focusing is a Fourier transform over time, and motion
      at frequency f appears at a depth of f times λ<sub>s</sub> R sin θ / 2V<sub>s</sub>, whatever is under the ground. Given
      the exact motion at every pair, with none of the blindness above, it still cannot say where a chamber is.
    </p>
    <div class="grid-2 charts">
      <LineChart
        directLabels={false}
        title="Fig. S5 · Where the published focusing puts motion of each frequency"
        series={[
          { name: 'f λs R sin θ / 2Vs, folded', x: fline, y: fline.map(fold), color: 'var(--muted)', width: 1.4 },
          { name: 'the pipeline, given the exact motion', x: drow.map((r) => r.f_hz), y: drow.map((r) => r.depth_m), color: 'var(--porphyry)', markers: true },
        ]}
        xLabel="frequency of the ground's motion, Hz"
        yLabel="published depth, m"
        caption={`The 2022 paper’s bank on the real geometry samples time at ${fsamp.toFixed(1)} Hz, so its whole axis, 0 to ${(dep.nyquist_depth_m as number).toFixed(1)} m, is 0 to ${(fsamp / 2).toFixed(1)} Hz, and faster motion folds back: Giza’s ${tones.giza_ground.f_hz} Hz ground resonance would be drawn at ${tones.giza_ground.depth_m.toFixed(1)} m, Khufu’s ${tones.khufu.f_hz} Hz at ${tones.khufu.depth_m.toFixed(1)} m.`}
      />
      <LineChart
        directLabels={false}
        title="Fig. S6 · The same microseism over two chambers and over open ground"
        series={[
          { name: 'chamber 15 m down', x: zax, y: prof6['chamber 15 m down'].tomogram, color: 'var(--lapis)', width: 3 },
          { name: 'chamber 30 m down', x: zax, y: prof6['chamber 30 m down'].tomogram, color: 'var(--porphyry)', dash: '6 4', width: 2 },
          { name: 'open ground', x: zax, y: prof6['open ground, the wave itself'].tomogram, color: 'var(--text)', dash: '1 3', width: 1.5 },
        ]}
        xLabel="published depth, m"
        yLabel="focused power, normalised"
        caption={`All three peak at ${prof6['chamber 15 m down'].depth_m.toFixed(2)} m, the depth of 0.2 Hz, and agree to rounding error; only their brightness differs.`}
      />
    </div>
    <RunDetails manifest={dep.manifest} />
  </section>

  <section id="chain">
    <h2>Run whole, the chain cannot tell the chamber is there</h2>
    <p class="sub">
      P2-07 runs the claim as it would have it: simulated desert over the one-chamber bench, shaking at Giza’s measured
      microseism level with the chamber’s imprint from P2-04, imaged on the real dwell in double precision, and put through
      the published pipeline unchanged (50 half-band pairs 88 Hz apart, 32-pixel patches, λ<sub>s</sub> = 0.48 m). The
      chamber changes the image by <Sci v={chain.A_vs_B.image_relative_difference} p={0} /> of itself (its imprint is{' '}
      <Sci v={chain.A_vs_B.imprint_phase_rad} p={0} /> rad of phase) and the depth section by{' '}
      <Sci v={chain.A_vs_B.method_relative_difference} p={0} />. The dashed outline is the chamber; with the published
      λ<sub>s</sub> the axis ends at {czmax.toFixed(1)} m, and any other λ<sub>s</sub> relabels the same pixels (P2-06).
    </p>
    <div class="grid-4">
      <Figure compact src={cfig('method_A.png')} alt="Depth section with the chamber" label="With the chamber" caption="" aspect="4 / 5" yTop="0 m" yBottom={`${czmax.toFixed(1)} m`}><svg viewBox="0 0 100 100" preserveAspectRatio="none"><rect x={croom.x} y={croom.y} width={croom.w} height={102 - croom.y} fill="none" stroke="#82b3ff" stroke-width="0.5" stroke-dasharray="1.6 1.1" vector-effect="non-scaling-stroke" /></svg></Figure>
      <Figure compact src={cfig('method_B.png')} alt="Depth section without the chamber" label="Without" caption="" aspect="4 / 5" yTop="0 m" yBottom={`${czmax.toFixed(1)} m`}><svg viewBox="0 0 100 100" preserveAspectRatio="none"><rect x={croom.x} y={croom.y} width={croom.w} height={102 - croom.y} fill="none" stroke="#82b3ff" stroke-width="0.5" stroke-dasharray="1.6 1.1" vector-effect="non-scaling-stroke" /></svg></Figure>
      <Figure compact src={cfig('method_difference.png')} alt="Their difference" label="Difference" caption="" aspect="4 / 5" yTop="0 m" yBottom={`${czmax.toFixed(1)} m`}><svg viewBox="0 0 100 100" preserveAspectRatio="none"><rect x={croom.x} y={croom.y} width={croom.w} height={102 - croom.y} fill="none" stroke="#82b3ff" stroke-width="0.5" stroke-dasharray="1.6 1.1" vector-effect="non-scaling-stroke" /></svg></Figure>
      <Figure compact src={cfig('method_boosted.png')} alt="Depth section with the imprint boosted" label={`Imprint × 10${String(Math.round(Math.log10(chain.shown_gain as number))).replace(/\d/g, (d) => '⁰¹²³⁴⁵⁶⁷⁸⁹'[+d])}`} caption="" aspect="4 / 5" yTop="0 m" yBottom={`${czmax.toFixed(1)} m`}><svg viewBox="0 0 100 100" preserveAspectRatio="none"><rect x={croom.x} y={croom.y} width={croom.w} height={102 - croom.y} fill="none" stroke="#82b3ff" stroke-width="0.5" stroke-dasharray="1.6 1.1" vector-effect="non-scaling-stroke" /></svg></Figure>
    </div>
    <div class="grid-2 charts">
      <div class="note-card">
        <span class="tag simulated">simulated · P2-07</span>
        <h3>Boosting the imprint until the method responds</h3>
        <table class="data compact">
          <thead><tr><th>imprint ×</th><th>phase, rad</th><th>section change</th><th>over the chamber</th><th>elsewhere</th></tr></thead>
          <tbody>
            {sweep.map((r) => <tr><td class="num"><Sci v={r.gain} p={0} /></td><td class="num"><Sci v={r.imprint_phase_rad} /></td><td class="num">{pct(r.method_relative_difference)}</td><td class="num">{pct(r.over_chamber)}</td><td class="num">{pct(r.elsewhere)}</td></tr>)}
          </tbody>
        </table>
        <p>Visible change needs the imprint multiplied by <Sci v={chain.shown_gain as number} p={0} />, tens of radians of phase, and even then it is spread over every depth ({(chain.boosted_change_spread as number[])[0].toFixed(2)}–{(chain.boosted_change_spread as number[])[1].toFixed(2)} of its mean): the texture is reshuffled, nothing is drawn at the chamber.</p>
      </div>
      <LineChart
        directLabels={false}
        title="Fig. S7 · Over the chamber: a seismometer against the dwell’s velocity series (R4’s reading)"
        series={[
          { name: 'seismometer', x: ccmp.seismometer_t_s as number[], y: (ccmp.seismometer_m_s as number[]).map(um), color: 'var(--ochre)', width: 2 },
          { name: 'the dwell', x: ccmp.look_times_s as number[], y: (ccmp.satellite_m_s as number[]).map(um), color: 'var(--cinnabar)', markers: true },
        ]}
        xLabel="s"
        yLabel="line-of-sight velocity, µm/s"
        zeroLine
        caption={`The ground moves ${um(ccmp.seismometer_rms_m_s).toFixed(3)} µm/s; the series wanders ${Math.round(um(ccmp.satellite_rms_m_s))} µm/s, ${Math.round(ccmp.satellite_rms_m_s / ccmp.seismometer_rms_m_s).toLocaleString('en-US')} times more, and not with it.`}
      />
    </div>
    <RunDetails manifest={chain.manifest} />
  </section>

  <section id="pillars">
    <h2>The published pictures’ pillars and boxes are the method’s own arithmetic</h2>
    <p class="sub">
      The published Khafre renderings show tall columns, banded like spirals, with blocks at their feet. P2-08 draws the same
      shapes from the real Khafre image with the published focusing, and each has a plain cause. <b>Pillars:</b> averaged over
      a period of its depth axis, the power the method draws at a pixel is that pixel’s trajectory energy (correlation{' '}
      {pk.pillar_corr_mean_power_vs_energy.toFixed(3)}), so a pixel whose registration wanders is bright at every depth and a
      thick-slab rendering stands it up as a column. Such pixels lie where the surface is darker or changes brightness; open
      plateau with no monument draws them too, and uniform simulated ground draws none. <b>Bands:</b> along a
      column the power rises and falls every {pk.resolution_m_shown.toFixed(0)} m of the relabelled axis, its resolution.{' '}
      <b>Blocks:</b> at the surface and at each repeat depth, {rep1.toLocaleString('en-US')} m and {(2 * rep1).toLocaleString('en-US')} m relabelled,
      every steering phase is the same, so the power there is the pixel’s average offset (ratio{' '}
      {pk.box_power_over_mean_offset.toFixed(3)}); below {rep1.toFixed(0)} m the picture repeats.
    </p>
    <div class="grid-3">
      <Figure compact src={pfig('khafre_section.png')} alt="The published method's depth section at Khafre" label="Khafre, the real image" caption="columns where the registration wanders" aspect="5 / 7" yTop="0 m" yBottom={`${pk.depth_shown_m.toFixed(0)} m`} />
      <Figure compact src={pfig('plateau_section.png')} alt="The same section over open plateau" label="Open plateau, no monument" caption="columns here too, with no monument" aspect="5 / 7" yTop="0 m" yBottom={`${pk.depth_shown_m.toFixed(0)} m`} />
      <Figure compact src={pfig('simulated_section.png')} alt="The same section over uniform simulated ground" label="Uniform simulated ground" caption="no columns: nothing wanders more than anything else" aspect="5 / 7" yTop="0 m" yBottom="" />
    </div>
    <p class="note">
      Rendered as the published pictures are: a thick slab, a log scale and a rainbow palette. The claimed chambers near
      1,220 m sit close to the second repeat, {(2 * rep1).toLocaleString('en-US')} m relabelled; that is suggestive only, since the
      published relabelling is not known exactly. In the <a href={`${base}/underworld/#bench-khafre-claim/recovered`}>3-D view</a>{' '}
      the method’s Khafre volume stands beside the claim. A published slice along a line is a row of pixels, each focused from its
      own shifts alone, so a volume is every row. The method’s “inversion” is only a Fourier transform of each pixel’s own shifts,
      with no waves modelled through the ground: for the Khafre patch’s
      {(pk.grid[0] * pk.grid[1]).toLocaleString('en-US')} pixels it takes a twentieth of a second, where a real seismic inversion of one
      small block takes hours (full-waveform inversion, on the seismic page). The costly step is measuring the shifts, which
      grows with the number of pixels; the lab refines each correlation peak locally (Guizar-Sicairos and others, 2008) instead of
      upsampling whole patches, so that patch took minutes, where every pixel of the whole image would take about two months.
    </p>
    <RunDetails manifest={pill.manifest} />
  </section>

  <section id="sensors">
    <h2>A radar image is not a dense seismic array</h2>
    <p class="sub">
      Every patch of an image can be read as a virtual seismometer, and there are millions of them, far denser than any real
      array; stacking many sensors does shrink their noise. P2-09 asks the prior question: do they hear? A test wave (60 m long,
      0.15 Hz, 2 mm/s: forty thousand times Giza’s microseisms, and slow enough that neighbouring sensors move differently)
      is put into the simulated image itself, and {vsens.sensors.n.toLocaleString('en-US')} sensors are read the way the first
      investigation read its velocity series. Read by complex correlation, as the published trackers read them, they recover{' '}
      {pct(vsens.gains.complex)} of the motion under them; by magnitudes, {pct(vsens.gains.magnitude)}. The first investigation’s
      array test (R11) had added its wave to the readings after tracking, so it never asked this.
    </p>
    <div class="grid-3">
      <Figure compact fill pixelated src={vfig('sensors_truth.png')} alt="The true motion under each sensor" label="The true motion" caption="the wave, under each sensor" aspect={vaspect} />
      <Figure compact fill pixelated src={vfig('sensors_complex.png')} alt="What complex correlation reports" label="Complex correlation" caption={`the published way: ${pct(vsens.gains.complex)}`} aspect={vaspect} />
      <Figure compact fill pixelated src={vfig('sensors_magnitude.png')} alt="What magnitudes report" label="Magnitudes" caption={`the best tracker: ${pct(vsens.gains.magnitude)}`} aspect={vaspect} />
    </div>
    <div class="grid-2 charts">
      <LineChart
        title="Fig. S9 · Stacking still sensors: the scatter falls as more are averaged"
        logX
        logY
        series={[
          { name: 'magnitudes', x: vst.magnitude.n, y: vst.magnitude.scatter_m_s.map(um), color: 'var(--cinnabar)', markers: true },
          { name: 'complex', x: vst.complex.n, y: vst.complex.scatter_m_s.map(um), color: 'var(--ochre)', markers: true },
          { name: 'n^−½', x: vst.magnitude.n, y: halfLine, color: 'var(--muted)', dash: '3 3', width: 1 },
        ]}
        xLabel="sensors averaged"
        yLabel="scatter, µm/s"
        caption={`Slope ${vst.magnitude.slope.toFixed(2)} for magnitudes: independent, as hoped. But averaging deaf sensors gives a precise zero, not the motion.`}
      />
      <div class="note-card">
        <span class="tag simulated">simulated · P2-09</span>
        <h3>How many sensors the chamber would need</h3>
        <table class="data compact">
          <tbody>
            <tr><td>needed over the chamber, where magnitudes hear a fifth</td><td class="num"><Sci v={vc.needed_for_chamber} p={0} /></td></tr>
            <tr><td>independent sensors over the chamber</td><td class="num">{Math.round(vc.in_footprint).toLocaleString('en-US')}</td></tr>
            <tr><td>in the whole image</td><td class="num"><Sci v={vc.in_image} p={0} /></td></tr>
            <tr><td>on all of Earth’s land</td><td class="num"><Sci v={vc.on_earth_land} p={0} /></td></tr>
            <tr><td>needed for the ground’s whole trembling, no chamber</td><td class="num"><Sci v={vc.needed_for_trembling} p={0} /></td></tr>
          </tbody>
        </table>
        <p>Even the trembling itself would need {Math.round(vc.needed_for_trembling / vc.in_image).toLocaleString('en-US')} times more sensors than the image holds. In the <a href={`${base}/underworld/#bench-void/satellite`}>3-D view</a> the sensors bob with the true motion beside what each reports.</p>
      </div>
    </div>
    <RunDetails manifest={vsens.manifest} />
  </section>

  <section id="every">
    <h2>Every other route from a buried room to a radar is closed too</h2>
    <p class="sub">
      A radar records echoes, and an echo depends on two things only: how strongly each scatterer returns the wave, and where
      each scatterer is while it is watched. A buried room can therefore reach the record in four ways and no others. P2-11
      bounds each, generously to the room, for the bench chamber (6 m, 15 m down), a large hall (20 m, 30 m down) and the claimed
      deep structure (80 m, 1,220 m down).
    </p>
    <table class="data">
      <thead><tr><th>Route</th><th>Best case</th><th>What it would take</th></tr></thead>
      <tbody>
        <tr>
          <td><b>The wave reaches the room</b><br /><span class="muted">penetration</span></td>
          <td>X band gets about {(eBands[0].sand_penetration_m * 100).toFixed(0)} cm into the driest sand, L band {eBands[1].sand_penetration_m.toFixed(0)} m, P band {eBands[2].sand_penetration_m.toFixed(0)} m; limestone conducts 50–200 times more than dry sand</td>
          <td>the bench chamber’s roof lies at least {dB(eBench.bands.X.two_way_loss_db_if_sand)} dB down at X band, the claimed structure {dB(eClaim.bands.X.two_way_loss_db_if_sand)} dB, against about 30 dB an image spans; only P band could reach a shallow room, inside its {Math.round(eA.biomass_slant_resolution_m)} m resolution cell with the surface</td>
        </tr>
        <tr>
          <td><b>The ground moves while the image is taken</b><br /><span class="muted">vibration</span></td>
          <td>the smallest motion ever measured from orbit, {(eB.smallest_measured_m_s * 1e3).toFixed(2)} mm/s on a corner reflector (2026), is <Sci v={eB.measured_over_imprint} p={0} /> times the chamber’s imprint</td>
          <td>shaking of {eB.shaking_needed_bench_m_s.toFixed(1)} m/s during the 25 s pass, over reflectors placed there in advance</td>
        </tr>
        <tr>
          <td><b>The ground deforms between images</b><br /><span class="muted">interferometry under varying loads</span></td>
          <td>the year’s heat wave moves the ground over the chamber by {(heatBench.imprint_m * 1e6).toFixed(1)} µm; tides, air pressure and the water table {(Math.min(...smallLoads) * 1e6).toFixed(2)}–{(Math.max(...smallLoads) * 1e6).toFixed(1)} µm</td>
          <td><Sci v={heatBench.passes_needed} p={0} /> passes at {eC.insar_mm} mm each, and the ground’s own seasonal breathing ({(eC.surface_breathing_m * 1e3).toFixed(2)} mm) is {Math.round(heatBench.breathing_over_imprint)} times larger</td>
        </tr>
        <tr>
          <td><b>The surface itself changes</b><br /><span class="muted">temperature, moisture</span></td>
          <td>{(every.D_surface.bench.surface_anomaly_k * 1e3).toFixed(1)} mK at the surface</td>
          <td>no radar responds to it</td>
        </tr>
      </tbody>
    </table>
    <p class="sub">
      Any processing, gates, stacking, tomography or machine learning included, is a function of the record and cannot restore
      what these routes do not carry. Where radar does see underground is long wavelengths in very dry ground: the Shuttle’s L band
      found buried river valleys under the Sahara in 1981, and ESA’s Biomass showed ancient riverbeds under the sand of Chad in 2025.
      A viewer that looks underground from radar data is possible there, for the top few metres, and not from an X-band image.
    </p>
    <details class="sources">
      <summary>Sources for the outside numbers</summary>
      <ul>{Object.values(every.sources as Record<string, string>).map((s) => <li>{s}</li>)}</ul>
    </details>
    <RunDetails manifest={every.manifest} />
  </section>

  <section id="real">
    <h2>The real pass, laid on the ground: what a viewer given radar data can honestly show</h2>
    <p class="sub">
      P2-12 takes the real 2025 image and puts it where it belongs: each metre of the Giza site is found in the image through
      the product’s own geolocation over the terrain and the pyramids, with the residual offset fitted against the brightness the
      surface predicts ({Math.abs(realpass.registration.shift_m[0]).toFixed(1)} m along the track,{' '}
      {Math.abs(realpass.registration.shift_m[1]).toFixed(1)} m across). Each pyramid’s top lands on the ground in front of it,
      toward the radar, as the radar records it. The wave reaches about {Math.round(realpass.reach_m * 100)} cm into dry sand at
      most. Run on this image, the published method draws its columns wherever the registration wanders (its power follows each
      pixel’s trajectory energy at {Math.min(...(realpass.patches as { pillar_power_vs_energy: number }[]).map((x) => x.pillar_power_vs_energy)).toFixed(4)}),
      Every patch draws columns: the pyramids, whose surfaces are busier, draw more of the strongest
      ({Math.round(Math.min(...(realpass.patches as { kind: string; share_in_top5: number }[]).filter((x) => x.kind === 'monument').map((x) => x.share_in_top5)) * 100)}–{Math.round(Math.max(...(realpass.patches as { kind: string; share_in_top5: number }[]).filter((x) => x.kind === 'monument').map((x) => x.share_in_top5)) * 100)}% of their
      pixels are among the noisiest 5%, against {(Math.min(...(realpass.patches as { kind: string; share_in_top5: number }[]).filter((x) => x.kind === 'control').map((x) => x.share_in_top5)) * 100).toFixed(1)}–{(Math.max(...(realpass.patches as { kind: string; share_in_top5: number }[]).filter((x) => x.kind === 'control').map((x) => x.share_in_top5)) * 100).toFixed(1)}% on open
      plateau), while their typical pixel wanders as much as open plateau’s. A pyramid’s picture differs from open plateau’s ({realpass.profile_corr.across.map((v: number) => v).reduce((a: number, b: number) => Math.min(a, b)).toFixed(2)}–{realpass.profile_corr.across.reduce((a: number, b: number) => Math.max(a, b)).toFixed(2)})
      by no more than two stretches of open plateau differ from each other
      ({realpass.profile_corr.within_controls.reduce((a: number, b: number) => Math.min(a, b)).toFixed(2)}–{realpass.profile_corr.within_controls.reduce((a: number, b: number) => Math.max(a, b)).toFixed(2)}).
    </p>
    <div class="grid-2">
      <Figure src={`${base}/data/sites/giza/radar-ground.jpg`} alt="The real radar image of the Giza plateau, resampled onto the ground" label="The 2025 pass on the ground" caption="north up; the bright wedges west of each pyramid are its top, laid over toward the radar" aspect="1600 / 1400" widthM={1600} bar={200} />
      <div class="note-card">
        <span class="tag measured">real image · P2-12</span>
        <h3>In the 3-D view</h3>
        <p>The <a href={`${base}/underworld/#giza/satellite`}>Giza site’s satellite mode</a> shows the pass over the plateau, this
        image draped on the terrain, and the method’s volume at Khafre, Khufu, Menkaure and open plateau, side by side with the
        chambers surveyed inside the pyramids.</p>
        <p>The same steps take any product: its geolocation and orbit give the pass and the image on the ground, and its band gives
        the reach. For X band that reach is a skin; long wavelengths over dry sand reach a few metres, which is where a radar image
        can show something underground.</p>
      </div>
    </div>
    <RunDetails manifest={realpass.manifest} />
  </section>

  <section id="rescue">
    <h2>What could rescue it, and why it does not</h2>
    <div class="grid-3">
      <div class="note-card"><h3>More motion</h3><p>Peterson’s high-noise model, 71 times Giza’s microseisms, leaves the plateau short by {order(noisyGround)}. Traffic exceeds 77 µm/s within 25 m of a road (P2-00), but at 10–30 Hz, where a look must be under 33 ms and resolves 33 m; short by {order(truckGround)} on ground. Khafre is 199 m from the nearest road.</p></div>
      <div class="note-card"><h3>Brighter targets</h3><p>Magnitude tracking follows an isolated bright scatterer in full (P2-03), so the best case is a stone or a placed corner reflector above the chamber: short by {order(brightShort)} and {order(reflShort)} under Giza’s microseisms, {order(noisyRefl)} for the reflector at the noisiest stations.</p></div>
      <div class="note-card"><h3>Other structures</h3><p>The imprint scales as volume over depth squared (checked against the solver, P2-04); the claimed deep structure scales to {(imp.claimed[0].relative_to_bench as number).toFixed(2)} of the bench chamber. Independently of any structure, Giza’s whole microseism motion is {wholeMotion.toLocaleString('en-US')} times below the plateau’s detection threshold.</p></div>
      <div class="note-card"><h3>A better estimator</h3><p>For fully developed speckle the Doppler bins are independent circular Gaussians, so a phase history shared by a patch leaves the image’s distribution unchanged: no estimator recovers it. What survives is point-like content (magnitudes, above) and the apparent brightness a displacement gradient makes, of order 10<sup>−11</sup> here.</p></div>
      <div class="note-card"><h3>The published images</h3><p>The pipeline draws structured sections from any input: identical with and without the chamber (P2-07), the same over monuments and open desert (R1, R6), no signal over hundreds of surveyed shafts (R13), and the published appearance everywhere (R8).</p></div>
      <div class="note-card"><h3>Vibration measured from orbit, 2026</h3><p>The method’s authors first applied this kind of tracking to bridges in Italy and to the Mosul Dam in 2020, without instruments on the structures at the same time. Two 2026 papers (Vattulainen et al., IEEE Access; Lotti et al., Structural Control and Health Monitoring) measure vibration from single spaceborne images against ground truth: corner reflectors on shakers in open fields, and a steel footbridge chosen because it is bright. They track isolated bright targets moving at 0.7 mm/s and up, with errors near 1 mm/s: what P2-03 says works. Their smallest motion is {Math.round(eB.measured_over_trembling).toLocaleString('en-US')} times Giza’s whole microseism motion and <Sci v={eB.measured_over_imprint} p={0} /> times the chamber’s imprint.</p></div>
      <div class="note-card"><h3>Only simulation?</h3><p>The coherence identity holds on the real crop to 10<sup>−9</sup>; the blindness is measured on real texture (1 ± 1%); the geometry is read from the product and reproduces its declared numbers; and the first investigation’s real-data controls found nothing at Giza or Sacsayhuamán.</p></div>
    </div>
  </section>

  <section id="record">
    <h2>What this corrects in the first investigation, and what still stands</h2>
    <div class="grid-2">
      <div class="note-card">
        <span class="tag measured">R9 · corrected</span>
        <h3>The coherence curve measured the looks, not the ground</h3>
        <p>Its 0.98 s to half and 1.76 s to a tenth are 1 − Δ/W for its 1.96 s looks, reproduced by simulated desert with no decorrelation and by the real crop’s own spectrum. How stable the ground is across a dwell has not been measured.</p>
      </div>
      <div class="note-card">
        <span class="tag measured">R4 · corrected</span>
        <h3>The 77 µm/s floor is noise, not sensitivity</h3>
        <p>It is the scatter of a complex registration that recovers {pct(blk.gain_complex)} of real ground’s motion. On bright point targets a magnitude tracker does follow motion, with a scatter of the same order.</p>
      </div>
      <div class="note-card">
        <span class="tag measured">R7 · corrected</span>
        <h3>The injected motion never came back</h3>
        <p>Its recovery gains sit near zero at every amplitude up to 1 cm, as expected of motion common to a whole crop of speckle. Its later frequencies, 1, 2 and 3 Hz, sit on the nulls of its looks.</p>
      </div>
      <div class="note-card">
        <span class="tag measured">R10 · corrected</span>
        <h3>Bright pixels were graded with the same identity</h3>
        <p>Complex coherence between one image’s looks is set by the spectrum whatever the pixels are. A lone bright scatterer’s envelope in fact follows its motion across the dwell.</p>
      </div>
      <div class="note-card">
        <span class="tag measured">R13 · stands</span>
        <h3>Hundreds of surveyed burial shafts give no signal at their depths</h3>
        <p>Over the Eastern and Western Cemeteries, shafts 5 to 30 m deep, the depth profiles match bare plateau, before and after matching surface brightness.</p>
      </div>
      <div class="note-card">
        <span class="tag measured">R2, R15, R16 · stand</span>
        <h3>The depth axis is set by the processing, and resolution by the look</h3>
        <p>The published axis folds within metres and repeats by an algebraic identity (P2-06 gives it a frequency); a look short enough to follow a wave through the ground resolves tens of metres at best.</p>
      </div>
    </div>
  </section>
