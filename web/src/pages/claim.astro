---
/** This page is now part of the overview; old links, anchors included, are forwarded there. */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const to = `${base}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Underworld</title>
    <link rel="canonical" href={to} />
    <meta http-equiv="refresh" content={`0; url=${to}#claim`} />
    <script is:inline define:vars={{ to, fallback: '#claim' }}>
      location.replace(to + (location.hash || fallback));
    </script>
  </head>
  <body>
    <p>This page is now part of <a href={`${to}#claim`}>the overview</a>.</p>
  </body>
</html>
