---
import Doc from '../layouts/Doc.astro';
import LineChart from '../components/LineChart.astro';
import Routes from '../components/Routes.astro';
import tight from '../../public/data/runs/p2_25_information_bound.json';
import requirement from '../../public/data/runs/p2_27_requirement.json';
import depths from '../../public/data/runs/p2_28_two_depths.json';
import oracle from '../../public/data/runs/p2_29_oracle.json';
import finite from '../../public/data/runs/p2_30_finite_certificates.json';
import shapes from '../../public/data/runs/p2_32_shape_bounds.json';
import shapeTest from '../../public/data/runs/p2_31_shape_test.json';
import bench from '../../public/data/runs/p2_36_benchmark.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// ---- formatting
const SUP = '⁰¹²³⁴⁵⁶⁷⁸⁹';
const sup = (n: number) => String(n).replace('-', '⁻').replace(/\d/g, (d) => SUP[+d]);
const sci = (v: number, p = 1) => {
  if (!(v > 0)) return '0';
  const e = Math.floor(Math.log10(Math.abs(v)));
  return Math.abs(e) < 3 ? String(+v.toPrecision(p + 1)) : `${(v / 10 ** e).toFixed(p)} × 10${sup(e)}`;
};
const pctp = (v: number, d = 2) => `${(100 * v).toFixed(d)}%`;

// ---- the benchmark (P2-36): one auditable comparison
type BmLayer = { tv_upper: number; state: string };
type BmPair = {
  pair: string[];
  l1: Record<string, BmLayer>;
  oracle: Record<string, BmLayer & { e_delta2: number }>;
  l1_growth_to_target: number | null;
  oracle_growth_to_target: number | null;
  oracle_snr_db_for_target: number | null;
  l1_disc: BmLayer;
  oracle_disc: BmLayer;
  tail_share_of_integral: number;
  achieved_score_test: { tv_achieved?: number; tv_achieved_best_phase?: number };
  sensitivity?: Record<string, { l1_tv_upper: number; l1_state: string; oracle_tv_upper: number; oracle_state: string }>;
  fixed_scenes?: { summary: Record<string, { mean: number; se: number }> };
  verify_line?: { rows: { amplification: number; exact_over_certificate: number | null }[]; floor: number };
  sigma_profile: { slope_40_70: number | null; outer_over_40m: number };
};
type BmCurve = { f_hz: number; l1_tv_upper: number; oracle_tv_upper: number; oracle_disc_tv_upper: number; tail_share: number };
const bm = bench as unknown as { f_star_hz: number; quiet: Record<string, BmPair>; strong: Record<string, BmPair>; curves: Record<string, BmCurve[]>; finding: string; manifest: { params: { frozen_hash: string } } };
const bmPairs = Object.keys(bm.strong);
const bmName: Record<string, string> = {
  'presence (room)': 'Presence: a room, or none',
  'presence (L tunnel)': 'Presence: an L-shaped tunnel, or none',
  'location (6 m)': 'Location: the room, or the room 6 m east',
  'shape (room or L tunnel)': 'Shape: the room, or the L tunnel',
};
const bmN = '30';
const bmMax = (exc: 'quiet' | 'strong', layer: 'l1' | 'oracle') => Math.max(...bmPairs.map((p) => bm[exc][p][layer][bmN].tv_upper));
const bmBandL1 = Math.max(...bmPairs.flatMap((p) => bm.curves[p].map((r) => r.l1_tv_upper)));
const bmBandOr = Math.max(...bmPairs.flatMap((p) => bm.curves[p].map((r) => r.oracle_tv_upper)));
const bmSnr = Math.min(...bmPairs.map((p) => bm.strong[p].oracle_snr_db_for_target ?? Infinity));
const bmGrowth = Math.min(...bmPairs.map((p) => bm.strong[p].l1_growth_to_target ?? Infinity));
const bmSensL1 = Math.max(...bmPairs.flatMap((p) => Object.values(bm.strong[p].sensitivity ?? {}).map((v) => v.l1_tv_upper)));
const bmFix = bm.strong[bmPairs[0]].fixed_scenes?.summary;
const bmVer = bm.strong[bmPairs[0]].verify_line?.rows[0]?.exact_over_certificate ?? null;
const bmTail = Math.max(...bmPairs.map((p) => bm.strong[p].tail_share_of_integral));
const bmSlope = bm.strong[bmPairs[0]].sigma_profile.slope_40_70;
const bmAch = (r: BmPair) => r.achieved_score_test.tv_achieved_best_phase ?? r.achieved_score_test.tv_achieved ?? null;
const stCls = (s: string) => (s === 'near chance' ? 'st-near' : s === 'unresolved' ? 'st-open' : 'st-excl');
const bmSingleOk = bmMax('strong', 'l1') < 0.9 && bmBandL1 < 0.9;

// ---- the three layers
type Cert = { case: string; tv_upper: number; tpr_upper_at_fpr_005: number; tight_ceiling_p2_25?: number | null };
type Dyn = Cert & { stress_11pct_tv_upper: number; stress_11pct_tpr_upper_at_fpr_005: number; stress_11pct_excludes_095_at_005: boolean; source_frequency_hz: number; background_tpr_upper_at_fpr_005?: number; background_excludes_095_at_005?: boolean };
const fc = finite as unknown as {
  static: Cert[];
  dynamic: Dyn[];
  background_included: { covariance_floor_proved_within_model: number; los_peak_envelope_m: number; rows: Cert[] };
  fixed_envelope_phase_modulation: (Cert & { affected_scatterer_pixels_assumed: number; nominal_ground_area_m2: number; informative: boolean })[];
  requirements: { q_exclusion_boundary_095_005: number; oracle_energy_necessary_for_tv_090: number; peak_displacement_boundary_at_1000_m2_m: number };
  geometry: { wavelength_m: number; area_density_used: number; in_band_bins: number; pixel_count: number };
  depth_oracle: { residual_fraction: number; separation_m: number; rows: { signal: string; tv_depth_upper: number; mean_depth_error_lower_m: number }[] } | null;
  finding: string;
};
type TS = { case: string; ceiling: number };
type TD = { case: string; urban: { ceiling: number }; truck: { ceiling: number; worst_f_hz: number } };
const tb = tight as unknown as { static: TS[]; dynamic: TD[]; checks: { detection: { pinsker_from_exact_kl: number; likelihood_ratio: { largest_pd_minus_pfa: number } }[] } };
type OrRow = { case: string; kind: string; delta: number; tv_upper: number; growth_to_target: number; growth_after_allowances: number; not_excluded_after_allowances: boolean; state?: string };
const orc = oracle as unknown as {
  chamber: OrRow[];
  allowance_product: number;
  raw_echo_check: { summary: Record<string, { mean: number; se: number }> };
  depth: { residual_fraction: number; signal_factor_depth_over_detection: number; pair_interaction_fraction: number; best_single_bench_room_residual: number };
  manifest: { params: { snr_db: number; nesz_best_db: number } };
};
const orFind = (s: string) => orc.chamber.find((r) => r.case.includes(s));
const dyn = (name: string) => fc.dynamic.find((r) => r.case === name)!;
const td = (name: string) => tb.dynamic.find((d) => d.case === name)!;
const withBg = (name: string) => fc.background_included.rows.find((r) => r.case === name);
const detOver = Math.max(...tb.checks.detection.map((d) => d.pinsker_from_exact_kl / d.likelihood_ratio.largest_pd_minus_pfa));

type Layer = { what: string; level: string; cert: number; certNote: string; tight: number | null; tightNote: string; oracle: number | null };
const s0 = tb.static;
const layers: Layer[] = [
  ...s0.map((r, i) => {
    const bg = withBg(r.case);
    const c = bg ?? fc.static[i];
    return {
      what: r.case.replace(', measured', ', regional'),
      level: i === 1 ? 'Peterson’s high-noise model' : 'Kottamya, 67 km east',
      cert: c.tv_upper,
      certNote: bg ? 'background included' : 'reference covariance I',
      tight: r.ceiling,
      tightNote: 'static imprint, every direction',
      oracle: orFind(r.case)?.tv_upper ?? null,
    };
  }),
  { what: 'Urban background, bench room', level: 'FTA, 8–100 Hz', cert: dyn('surface: urban-level harmonic').tv_upper, certNote: 'surrogate: reference without the traffic’s own motion', tight: td('surface').urban.ceiling, tightNote: 'surrogate, likewise', oracle: orFind('urban background, all pass (surface)')?.tv_upper ?? null },
  { what: 'A lorry over a bump 15 m away, bench room', level: 'FTA, all pass', cert: dyn('surface: truck-level harmonic').tv_upper, certNote: 'surrogate: reference without the lorry’s own motion', tight: td('surface').truck.ceiling, tightNote: 'surrogate, likewise', oracle: orc.chamber.filter((r) => r.case.startsWith('truck over a bump 15 m away, all pass, at') && r.case.endsWith('(surface)'))[0]?.tv_upper ?? null },
  { what: 'The same lorry, a room under a 5 m roof', level: 'FTA, all pass', cert: dyn('surface_favourable: truck-level harmonic').tv_upper, certNote: 'surrogate: reference without the lorry’s own motion', tight: td('surface_favourable').truck.ceiling, tightNote: 'surrogate, likewise', oracle: orc.chamber.filter((r) => r.case.startsWith('truck over a bump 15 m away, all pass, at') && r.case.endsWith('(surface_favourable)'))[0]?.tv_upper ?? null },
];
const micro = fc.background_included.rows[0];
const orTruck = (key: string) => orc.chamber.filter((r) => r.case.startsWith('truck over a bump 15 m away, all pass, at') && r.case.endsWith(`(${key})`))[0];
const orThin = orTruck('surface_favourable');
const orBenchTruck = orTruck('surface');
const orAmb = Math.max(...orc.chamber.filter((r) => r.kind === 'ambient').map((r) => r.tv_upper));
const orReg = orFind(s0[0].case)?.tv_upper ?? orAmb;   // the regional microseisms, as the certificate and tight rows quote
const orOpen = orc.chamber.filter((r) => r.not_excluded_after_allowances);

// ---- shape discrimination (P2-32)
type ShRow = { case: string; tight_ceiling: number; oracle_tv: number; oracle_growth_to_target: number | null; certificate_tpr_at_005: number };
type ShPair = { pair: string; rows: ShRow[]; discrimination_signal_factor: number | null };
type ShDyn = { pair: string; worst_f_hz: number; oracle_tv: number; oracle_growth_to_target: number | null; oracle_tv_within_32m: number };
const sh = shapes as unknown as { static: ShPair[]; dynamic: ShDyn[] };
const pairName: Record<string, string> = {
  'branching_tunnel vs none': 'A branching tunnel, or none',
  'L_tunnel vs straight_tunnel': 'An L-shaped tunnel, or a straight one',
  'column_spiral vs column': 'A column with a spiral, or a plain column',
  'L_tunnel vs branching_tunnel': 'An L-shaped tunnel, or a branching one',
  'room vs none': 'An isolated room, or none',
};
const shDyn = (pair: string) => sh.dynamic.find((d) => d.pair === pair);
const shMaxCert = Math.max(...sh.static.map((p) => p.rows[0].certificate_tpr_at_005));
const shWorstDyn = sh.dynamic.length ? sh.dynamic.reduce((a, d) => (d.oracle_tv > a.oracle_tv ? d : a)) : null;

// ---- the shape test (P2-31): generated scenes, read blind
type StR = { presence_auc_vs_controls: number | null; shape_accuracy: number | null; shape_p_permutation?: number | null; median_location_error_m: number | null; median_centroid_error_m?: number | null; median_presence_z_at_true_place?: number | null };
type StLvD = StLv & { published_depth_error_after_allowance_m: number | null };
type StLv = { reference: StR; published_blind: StR; published_paired: StR };
const stSum = (shapeTest as unknown as { summary: Record<string, unknown> }).summary;
const stNum = (k: string) => (typeof stSum[k] === 'number' ? (stSum[k] as number) : null);
const stLevels = ([['real', 'real level (the microseisms)'], ['diagnostic_0.3_rad', '0.3 rad, amplified'], ['diagnostic_2_rad', '2 rad, amplified'], ['diagnostic_20_rad', '20 rad, the positive control']] as const)
  .filter(([k]) => stSum[k]).map(([k, label]) => ({ k, label, v: stSum[k] as StLv }));
const stPos = stLevels.find((l) => l.k === 'diagnostic_20_rad')?.v;
const stMid = stLevels.find((l) => l.k === 'diagnostic_2_rad')?.v;
const pc0 = (v: number | null | undefined) => (v == null ? '—' : `${Math.round(100 * v)}%`);
const named = (r: StR) => `${pc0(r.shape_accuracy)}${r.shape_p_permutation != null && r.shape_p_permutation < 0.2 ? ` (p ${r.shape_p_permutation < 0.001 ? '< 0.001' : r.shape_p_permutation.toFixed(2)})` : ''}`;
const m1 = (v: number | null | undefined) => (v == null ? '—' : `${v < 10 ? v.toFixed(1) : Math.round(v)} m`);

// ---- the requirement (P2-27)
type RqRow = { L_m: number; area_half_m2: number; D_necessary_m: Record<string, number> };
type RqLin = { L_m: number; area_half_m2: number; D_linearised_m: Record<string, number> };
type RqImp = { label: string; f_hz: number; kind?: string; area_half_m2: number; peak_m: number; short_by: number; displacement_integral_m4?: number; oracle_tv_upper?: number; outcome?: string; short_by_oracle?: number; short_by_certificate?: number; short_by_oracle_near_only?: number; oracle_tv_upper_near_only?: number };
type RqAmb = { label: string; f_hz: number; constrained_short_by: number; phase_only_area_oracle_m2?: number; phase_only_area_certificate_m2?: number };
type RqPat = { f_hz: number; gaussian_share_of_envelope_bound: number; ratio_to_gaussian: Record<string, number> };
const rq = requirement as unknown as {
  acquisitions: Record<string, { frequencies: { f_hz: number; exact: RqRow[]; linear: RqLin[] }[] }>;
  constrained: { modelled_ratio: number };
  ambient: RqAmb[];
  imprints: RqImp[];
  any_pattern?: { E_min_oracle_m4: Record<string, number>; E_min_m4: Record<string, number>; E_min_identity_m4: Record<string, number>; oracle_snr_db: number };
  pattern_check?: RqPat[];
  static_integral?: { solver_over_analytic_largest: number[]; envelope_margin: number; tail_bound_m2: number; in_grid_lambda_max_m2: number };
};
const Eor = rq.any_pattern?.E_min_oracle_m4['0.9'] ?? null;     // the oracle with receiver noise: any pattern, any common motion
const Eor05 = rq.any_pattern?.E_min_oracle_m4['0.05'] ?? null;  // within five points of chance
const Emin = rq.any_pattern?.E_min_m4['0.9'] ?? null;           // the certificate, Giza's background in the reference: quiet ground
const pat02 = rq.pattern_check?.find((r) => r.f_hz === 0.2);
const pat80 = rq.pattern_check?.find((r) => r.f_hz === 80);
const phaseArea = rq.ambient.find((a) => a.label.includes('microseisms, regional'))?.phase_only_area_oracle_m2 ?? null;
const shortTxt = (v: number | undefined) => (v == null ? '—' : v < 1 ? `not excluded (${v.toFixed(2)})` : v < 10 ? v.toFixed(2) : sci(v));
// a bound on detection minus false alarm, with the digits its threshold needs (0.895 is not 0.9)
const tvTxt = (v: number | null | undefined) => (v == null ? '—' : v >= 0.01 ? v.toFixed(v >= 0.85 ? 3 : 2) : sci(v));
const rqMain = rq.acquisitions['giza-20250827'].frequencies;
const rqColours = ['var(--lapis)', 'var(--verdigris)', 'var(--ochre)', 'var(--porphyry)', 'var(--cinnabar)'];
// every pattern, by its energy: a motion filling a footprint A evenly with peak D is excluded while D^2 A < E_min
const anyCurve = (E: number | null) => (E == null ? [] : [1, 10, 100, 1e3, 1e4, 1e5].map((A) => ({ A, D: Math.sqrt(E / A) })));

// ---- depth (P2-28, P2-29, P2-30)
type DRes = { share_12_18_m: number; share_27_33_m: number; axis_share_12_18_m: number; axis_share_27_33_m: number; peak_depth_m: number; over_room: number; elsewhere: number };
const dp = depths as unknown as { results: Record<string, DRes>; follows_depth: boolean; depth_axis_m: number[] };
const d15 = dp.results['hollow_15_phase_2'];
const d30 = dp.results['hollow_30_phase_2'];
const dNull = dp.results['null'];
const conc = (r: DRes) => r.over_room / r.elsewhere;
---
<Doc
  title="The bound, finite and stated"
  kicker="Proof · what any way of reading one image could learn, and what it assumes"
  current="satellite"
  lede="Does one satellite radar image hold reproducible information about what is underground (whether something is there, where it is, its shape) even if its depth stays uncertain? Within a stated measurement model this can be bounded for every algorithm at once, for detection and for telling one layout from another, in three layers, each proved without a small-motion approximation. The aim is a defensible boundary: which conditions rule out useful recovery and which deserve experiments. The physical inputs, a structure’s imprint and the shaking’s level, are models and are marked as such."
  state="status · proved within a stated model; physical inputs not certified · corrected after review, 30 September 2026"
  index={[
    { id: 'answer', label: 'The answer' },
    { id: 'benchmark', label: 'The benchmark' },
    { id: 'claims', label: 'Five claims, apart' },
    { id: 'shape', label: 'Shape, bounded' },
    { id: 'boundary', label: 'The boundary' },
    { id: 'layers', label: 'Three layers' },
    { id: 'theorems', label: 'The theorems' },
    { id: 'mechanism', label: 'What a mechanism must supply' },
    { id: 'depth', label: 'Depth' },
    { id: 'open', label: 'What stays open' },
  ]}
>
  <section id="answer">
    <h2>{bmSingleOk
      ? 'Within the model no way of reading one image reaches a useful detection under the ground’s own trembling, nor, in the benchmark, with a lorry beside a shallow room: only a detector told every scatterer’s reflectivity could, at a higher SNR than assumed'
      : 'Within the model no way of reading one image reaches a useful detection under the ground’s own trembling; with a lorry beside a shallow room the benchmark leaves cases open'}</h2>
    <div class="stat-row">
      <div class="stat"><span class="value">+{tvTxt(bmMax('quiet', 'l1'))}</span><span class="what">found ≤ false alarms + this, for any way of reading one image, under Giza’s regional microseisms: presence, a 6 m location or shape of a room under a 5 m roof</span><span class="src">P2-36 · per-line certificate</span></div>
      <div class="stat"><span class="value">+{tvTxt(bmMax('strong', 'l1'))}</span><span class="what">the same with a lorry over a bump 15 m away all pass, its wave in every line’s reference ({tvTxt(bmBandL1)} at the worst frequency of the band; {tvTxt(bmSensL1)} under the tabulated allowances)</span><span class="src">P2-36 · the benchmark</span></div>
      <div class="stat"><span class="value">+{tvTxt(bmMax('strong', 'oracle'))}</span><span class="what">an oracle told every scatterer’s reflectivity as well (a perfect reference image, which one image does not give), at 30 dB assumed; it reaches 0.9 at {Math.round(bmSnr)} dB. An upper bound, not a detection</span><span class="src">P2-36 · the oracle, pulse by pulse</span></div>
    </div>
    <p class="sub">
      A detection target of 95% found with 5% false alarms needs the two hypotheses to differ by a total variation of at
      least 0.9; every processor of the same measurements, tomograms and learned models included, inherits whatever total
      variation the measurements have. The certificate applied line by line bounds every reader of the one image within
      fully developed speckle, with each world’s own motion in its reference; the oracle, told the reflectivity too, needs
      no model of the texture, so it bounds what even a perfect reference image could add. Under the ground’s own
      trembling both leave nothing useful. With a lorry beside a shallow room the single image still holds too little for
      95% at 5% ({bmPairs.filter((p) => bm.strong[p].l1[bmN].state === 'near chance').length} of the four questions near chance); what the oracle’s larger bound
      shows is that a detector told the reflectivity could, at a higher SNR than the 30 dB assumed.
    </p>
    <Routes />
  </section>

  <section id="benchmark">
    <h2>{bmSingleOk
      ? `One auditable comparison: one image under speckle reaches neither presence, a 6 m location nor shape, quiet or with a lorry 15 m away; only a detector told every reflectivity could, above ${Math.round(bmSnr)} dB`
      : 'One auditable comparison: presence, location and shape, bounded and achieved, quiet and with a lorry 15 m away'}</h2>
    <p class="sub">
      Four worlds identical but for the cavity: none; a room 6 m on a side under a 5 m roof; an L-shaped tunnel at the same
      depth; the room 6 m east. The same source, scatterers and noise law in each; the whole 5 km image observed; the
      solver’s field within 70 m, an assumed envelope beyond (a surface wave carried to the image’s edge without
      attenuation, {Math.round(100 * bmTail)}% of the signal). Quiet: Giza’s regional microseisms, expected over the field.
      Favourable: a lorry over a bump 15 m west, its FTA level held at {Math.round(bm.f_star_hz)} Hz for the whole pass (the
      frequency fixed by a rule before the bounds). Specification: <a href="https://github.com/ejhong/sar/blob/main/BENCHMARK.md">BENCHMARK.md</a>; run P2-36.
    </p>
    <table class="data compact">
      <thead><tr><th>which of the two?</th><th>quiet: any reader, one image</th><th>quiet: oracle</th><th>lorry: any reader, one image</th><th>lorry: oracle, {bmN} dB</th><th>oracle reaches 0.9 at</th><th>achieved, lorry: score test</th></tr></thead>
      <tbody>
        {bmPairs.map((p) => {
          const q = bm.quiet[p], st = bm.strong[p];
          return (
            <tr>
              <td>{bmName[p] ?? p}</td>
              <td class={stCls(q.l1[bmN].state)}>{tvTxt(q.l1[bmN].tv_upper)}<br /><span class="dim">{q.l1[bmN].state}</span></td>
              <td class={stCls(q.oracle[bmN].state)}>{tvTxt(q.oracle[bmN].tv_upper)}<br /><span class="dim">{q.oracle[bmN].state}</span></td>
              <td class={stCls(st.l1[bmN].state)}>{tvTxt(st.l1[bmN].tv_upper)}<br /><span class="dim">{st.l1[bmN].state}; motion ×{st.l1_growth_to_target != null ? (st.l1_growth_to_target < 100 ? st.l1_growth_to_target.toFixed(0) : sci(st.l1_growth_to_target)) : '—'} to reach 0.9</span></td>
              <td class={stCls(st.oracle[bmN].state)}>{tvTxt(st.oracle[bmN].tv_upper)}<br /><span class="dim">{st.oracle[bmN].state}</span></td>
              <td>{st.oracle_snr_db_for_target != null ? `${Math.round(st.oracle_snr_db_for_target)} dB` : '—'}</td>
              <td>{tvTxt(bmAch(st))}<br /><span class="dim">within 70 m</span></td>
            </tr>
          );
        })}
      </tbody>
    </table>
    <p class="note">
      Detection rate − false-alarm rate, at most (found ≤ false alarms + the entry, at every operating point); near chance
      below 0.05, 95% at 5% excluded below 0.9, unresolved above. “Any reader, one image”: the per-line certificate, told
      the excitation and both worlds’ whole motion but not the speckle, each along-track line’s reference holding the
      lorry’s own wave and the receiver noise (the whole-image floor failed there; one line’s floor stays near one); it
      bounds every method that reads the single image, the published one included. The oracle is told every scatterer’s
      reflectivity as well, as a perfect reference image would tell it; its bound failing is a strong exclusion, its bound
      succeeding shows only that a privileged detector could. SNR {bmN} dB is assumed (the acquisition’s calibration is not
      in this repository); the single-image layer barely depends on it. Over the whole band the single-image bound is at
      most {tvTxt(bmBandL1)} (the oracle’s {tvTxt(bmBandOr)}); under the tabulated allowances (grid, tail ×2 and ×5,
      attenuation) at most {tvTxt(bmSensL1)}; the lorry’s motion would have to grow {bmGrowth < 100 ? bmGrowth.toFixed(0) : sci(bmGrowth)} times.
      Checks: pulse by pulse on fixed scenes the coherent echo difference is {bmFix ? `${bmFix.common_x1.mean.toFixed(3)} ± ${bmFix.common_x1.se.toFixed(3)}` : '—'} of
      the ensemble formula ({bmFix ? `${bmFix.common_x10.mean.toFixed(3)}` : '—'} with the lorry’s wave ten times larger); on one line of the model the exact
      divergence is {bmVer != null ? bmVer.toFixed(2) : '—'} of its certificate; the scattered wave’s energy per metre of radius from 40 to 70 m
      scales as r^{bmSlope != null ? bmSlope.toFixed(1) : '—'} (flat for an unattenuated surface wave). The score test, told the pattern, is an implemented
      statistic’s weak-signal performance, not a bound.
    </p>
    <div class="grid-2 charts">
      <LineChart
        title={`${bmName[bmPairs[0]]}, with the lorry, across the FTA band`}
