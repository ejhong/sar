---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Seal from '../components/Seal.astro';

interface Props {
  title?: string;
  description?: string;
  /** Full-height instrument layout (the underworld): no page scroll. */
  app?: boolean;
  current?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'Katabasis: a simulation lab for imaging the underworld. Seismic tomography and satellite radar, simulated over ground whose contents are known, then applied to Giza, to test whether one radar image can map what lies beneath.',
  app = false,
  current = '',
  noindex = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullTitle = title ? `${title} · Katabasis` : 'Katabasis · a simulation lab for the underworld';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="theme-color" content="#e4dccd" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body class:list={[{ app }]}>
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <TopBar current={current} />
    <main id="main" class:list={[{ 'app-main': app }]}>
      <slot />
    </main>
    {
      !app && (
        <footer class="page-footer">
          <Seal size={22} />
          <p class="mono">Katabasis · © 2026 Eugene Jhong</p>
          <p class="mono links">
            <a href="https://github.com/ejhong/sar">source</a>
            <a href={`${base}/method/`}>method</a>
            <a href={`${base}/archive/`}>the first investigation</a>
            <a href="https://ejhong.github.io/knots/">knots</a>
          </p>
          <p class="mono fine">every figure says whether it is simulated or measured · nothing here is a field detection</p>
        </footer>
      )
    }
  </body>
</html>

<style is:global>
  body.app {
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .app-main {
    flex: 1;
    display: flex;
    min-height: 0;
    padding: 16px;
    gap: 16px;
  }
  .page-footer {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 44px 24px 48px;
    font-size: 9.5px;
    color: var(--muted);
    text-align: center;
  }
  .page-footer .seal {
    margin-bottom: 6px;
    opacity: 0.85;
  }
  .page-footer .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 0;
  }
  .page-footer .links a {
    color: var(--accent-dark);
    text-decoration: none;
  }
  .page-footer .links a:hover {
    color: var(--lapis);
  }
  .page-footer .links a + a::before {
    content: '·';
    color: var(--faint);
    margin: 0 9px;
  }
  .page-footer .fine {
    color: var(--faint);
    font-size: 9px;
  }
  .skip:focus {
    position: fixed !important;
    top: 8px;
    left: 8px;
    width: auto;
    height: auto;
    clip: auto;
    z-index: 2000;
    background: var(--sheet);
    padding: 6px 12px;
  }
  @media (max-width: 900px) {
    .app-main {
      flex-direction: column;
      padding: 8px;
      gap: 8px;
    }
  }
</style>
