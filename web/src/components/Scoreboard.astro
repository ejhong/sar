---
/**
 * Every method against the one-chamber bench, as far as the lab has got:
 * generated from the published runs, planned rows marked as planned.
 */
import tt from '../../public/data/runs/p1_02_traveltime.json';
import sc3 from '../../public/data/runs/p1_03_scattered.json';
import am from '../../public/data/runs/p1_04_ambient.json';
import fw from '../../public/data/runs/p1_05_fwi.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pct = (v: number) => `${v > 0 ? '+' : ''}${(v * 100).toFixed(1)}%`;
const cx = tt.surveys.crosshole.score;
const su = tt.surveys.surface.score;
const rows = [
  { method: 'Travel-time tomography', survey: 'crosshole · four boreholes', f: '250 Hz', rec: pct(cx.chamber_mean_rel), cnr: `${cx.contrast_to_noise.toFixed(1)}×`, status: 'done', run: 'p1_02_traveltime', href: '#traveltime' },
  { method: 'Travel-time tomography', survey: 'surface · hammer and geophone grids', f: '120 Hz', rec: pct(su.chamber_mean_rel), cnr: `${Math.max(0, su.contrast_to_noise).toFixed(1)}×`, status: 'done', run: 'p1_02_traveltime', href: '#traveltime' },
  { method: 'Echo imaging (RTM)', survey: 'surface · same grids, the chamber\u2019s echo', f: '120 Hz', rec: `lit, ${sc3.score.brightest_offset_from_chamber_m.toFixed(1)} m off centre`, cnr: `${sc3.score.contrast.toFixed(1)}×`, status: 'done', run: 'p1_03_scattered', href: '#echo' },
  { method: 'Ambient-noise echo imaging', survey: 'surface · same geophones, noise as virtual sources', f: `~${am.manifest.params.noise_band_centre_hz} Hz`, rec: `brightest ${am.score.brightest_offset_from_chamber_m.toFixed(1)} m off centre`, cnr: `${am.score.image_contrast_ensemble.toFixed(1)}×`, status: 'done', run: 'p1_04_ambient', href: '#ambient' },
  { method: 'Full-waveform inversion', survey: 'surface · same records, from a practitioner’s start', f: '120 Hz', rec: `${pct(fw.score.vs.chamber_mean_rel)} in S speed`, cnr: `${fw.score.vs.contrast_to_noise.toFixed(1)}×`, status: 'done', run: 'p1_05_fwi', href: '#fwi' },
];
---
<table class="data scoreboard">
  <thead>
    <tr><th>Method</th><th>Survey</th><th>Frequency</th><th class="r">Chamber recovered</th><th class="r">vs scatter</th><th>State</th></tr>
  </thead>
  <tbody>
    {
      rows.map((r) => (
        <tr class={r.status}>
          <td><a href={r.href}>{r.method}</a></td>
          <td>{r.survey}</td>
          <td class="mono">{r.f}</td>
          <td class="num">{r.rec}</td>
          <td class="num">{r.cnr}</td>
          <td>
            <span class={`st ${r.status}`}>{r.status}</span>
            {r.run && r.status === 'done' && <a class="run" href={`${base}/data/runs/${r.run}.json`}>{r.run}</a>}
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
<p class="sb-note">Chamber recovered: mean relative P-wave speed inside the true chamber (air would read −90%); for echo imaging, where the image is brightest; for full-waveform inversion, mean relative S-wave speed. vs scatter: that anomaly over the image's own level around it. One chamber, 6 m, top 12 m down, bare limestone, noise 30 dB below each record's peak; ambient noise with an unlimited record (record length is the question, see below).</p>

<style>
  .scoreboard a {
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  .scoreboard a:hover {
    color: var(--lapis);
  }
  .scoreboard .r {
    text-align: right;
  }
  .scoreboard td.mono {
    font-size: 11px;
    color: var(--muted);
  }
  .scoreboard tr.planned td,
  .scoreboard tr.next td {
    color: var(--muted);
  }
  .st {
    display: inline-block;
    font: 600 9px/1 var(--font-mono);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 3px 7px;
    margin-right: 8px;
  }
  .st.done {
    color: var(--verdigris);
  }
  .st.next {
    color: var(--lapis);
    border-style: dashed;
  }
  .st.planned {
    color: var(--muted);
    border-style: dashed;
  }
  a.run {
    font: 10px var(--font-mono);
    font-weight: 400;
    color: var(--muted);
  }
  .sb-note {
    font-family: var(--font-serif);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--muted);
    margin-top: 10px;
    max-width: 820px;
  }
</style>
