---
/**
 * The front page's opening: deep water, the underworld touring its sites on
 * its own (no controls, never catching the scroll), the thesis, and two ways
 * in. The tour stops are data; add the wavefield stop once it is published.
 */
import type { TourStop } from '../viewer/Underworld';
interface Props {
  stops: TourStop[];
}
const { stops } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="hero" aria-label="Katabasis">
  <div class="hero-stage uw" data-tour={JSON.stringify(stops)} data-theme="night">
    <canvas aria-hidden="true"></canvas>
    <div class="hero-shade"></div>
  </div>
  <div class="hero-copy">
    <p class="hero-kicker">A simulation lab for the underworld</p>
    <h1>What can see beneath the ground, and how far down</h1>
    <p class="hero-lede">
      In 2025 a team announced an underground city beneath Khafre's pyramid, mapped from a single satellite radar image.
      Katabasis tests that idea the way physics can: build ground whose contents are known, send the instruments over
      it, and measure what each one recovers — the seismic arrays geophysicists trust first, then the satellite.
    </p>
    <div class="hero-cta">
      <a class="cta primary" href={`${base}/underworld/`}>Enter the underworld →</a>
      <a class="cta" href={`${base}/seismic/`}>The seismic chapter</a>
    </div>
  </div>
  <div class="hero-caption" data-uw="caption" aria-live="polite"></div>
</section>

<script>
  import { Underworld } from '../viewer/Underworld';
  const root = document.querySelector<HTMLElement>('.hero-stage');
  if (root) {
    const stops = JSON.parse(root.dataset.tour!);
    const cap = document.querySelector<HTMLElement>('.hero-caption')!;
    // the caption lives outside the stage; give the viewer a root that holds both
    const holder = root.parentElement as HTMLElement;
    const uw = new Underworld({ root: holder, tour: stops });
    uw.start().catch((e) => {
      console.error(e);
      cap.textContent = '';
    });
  }
</script>

<style>
  .hero {
    position: relative;
    background: var(--night);
    height: min(80vh, 760px);
    min-height: 520px;
    overflow: hidden;
    border-bottom: 1px solid #0b131c;
  }
  .hero-stage {
    position: absolute;
    inset: 0;
  }
  .hero-stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* a soft wash so the copy reads over the scene */
  .hero-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(15, 24, 34, 0.92) 0%, rgba(15, 24, 34, 0.72) 30%, rgba(15, 24, 34, 0) 58%),
      linear-gradient(0deg, rgba(15, 24, 34, 0.6) 0%, rgba(15, 24, 34, 0) 24%);
  }
  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 1400px;
    margin: 0 auto;
    padding: clamp(40px, 9vh, 96px) 28px 0;
    pointer-events: none;
  }
  .hero-copy > * {
    max-width: 520px;
  }
  .hero-kicker {
    font: 600 10.5px/1 var(--font-mono);
    letter-spacing: 1.1px;
    text-transform: uppercase;
    color: var(--lapis-night);
  }
  .hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(34px, 4.4vw, 54px);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.6px;
    color: #f1f5f8;
    margin: 16px 0 18px;
  }
  .hero-lede {
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.6;
    color: #b9c7d3;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
    pointer-events: auto;
  }
  .cta {
    font: 500 13px/1 var(--font-sans);
    color: var(--panel-text);
    text-decoration: none;
    border: 1px solid rgba(223, 230, 236, 0.28);
    border-radius: 999px;
    padding: 11px 18px;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .cta:hover {
    border-color: rgba(223, 230, 236, 0.6);
    color: #fff;
  }
  .cta.primary {
    background: #e8eef3;
    color: #132030;
    border-color: #e8eef3;
  }
  .cta.primary:hover {
    background: #fff;
    color: #0f1822;
  }
  .hero-caption {
    position: absolute;
    right: 28px;
    bottom: 22px;
    z-index: 1;
    max-width: 380px;
    text-align: right;
    font-family: var(--font-serif);
    font-size: 13.5px;
    line-height: 1.5;
    color: #c9d5df;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.9s var(--ease), transform 0.9s var(--ease);
    pointer-events: none;
  }
  .hero-caption:global(.on) {
    opacity: 1;
    transform: none;
  }
  .hero-caption :global(b) {
    display: block;
    font: 600 9.5px/1.6 var(--font-mono);
    letter-spacing: 0.9px;
    text-transform: uppercase;
    color: var(--panel-muted);
  }
  @media (max-width: 900px) {
    .hero {
      height: auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }
    .hero-stage {
      position: relative;
      height: 52vh;
      order: 2;
    }
    .hero-shade {
      background: linear-gradient(0deg, rgba(15, 24, 34, 0.7) 0%, rgba(15, 24, 34, 0) 30%);
    }
    .hero-copy {
      order: 1;
      padding: 34px 18px 8px;
    }
    .hero-caption {
      left: 18px;
      right: 18px;
      text-align: left;
      max-width: none;
    }
  }
</style>
