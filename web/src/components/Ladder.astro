---
/**
 * The ladder of instruments: the site's organising figure. One chamber in
 * the ground, and every way of looking for it, from a borehole beside it to a
 * satellite 600 km away, each with its verdict so far. Verdicts are read from
 * the published runs; rungs without a run say what comes next.
 */
import tt from '../../public/data/runs/p1_02_traveltime.json';
import sc3 from '../../public/data/runs/p1_03_scattered.json';
import am from '../../public/data/runs/p1_04_ambient.json';
import sees from '../../public/data/runs/p2_03_what_a_dwell_sees.json';
import bud from '../../public/data/runs/p2_05_budget.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cx = tt.surveys.crosshole.score;
const su = tt.surveys.surface.score;
const pct = (v: number) => `${v > 0 ? '+' : ''}${(v * 100).toFixed(0)}%`;
const short = (bud.rows as { target: string; shortfall: number | null }[])[1].shortfall!;
const shortText = `10${String(Math.round(Math.log10(short))).replace(/\d/g, (d) => '⁰¹²³⁴⁵⁶⁷⁸⁹'[+d])}`;

type Status = 'found' | 'faint' | 'nothing' | 'next' | 'planned' | 'measured';
const rungs: { n: number; name: string; where: string; distance: string; verdict: string; status: Status; href: string }[] = [
  { n: 1, name: 'Crosshole travel times', where: 'sparker and hydrophones down four boreholes', distance: '9 m', verdict: `chamber recovered as a ${pct(cx.chamber_mean_rel)} shadow, ${cx.contrast_to_noise.toFixed(1)}× the scatter`, status: 'found', href: '/seismic/#traveltime' },
  { n: 2, name: 'Surface travel times', where: 'hammer grid over a geophone grid', distance: '12 m', verdict: `nothing (${pct(su.chamber_mean_rel)}): no first arrival reaches the chamber`, status: 'nothing', href: '/seismic/#traveltime' },
  { n: 3, name: 'Echo imaging', where: 'the same surface records, the chamber’s scattered wave migrated back', distance: '12 m', verdict: `lit at the chamber, ${sc3.score.contrast.toFixed(0)}× the image elsewhere, with the rock known exactly`, status: 'found', href: '/seismic/#echo' },
  { n: 4, name: 'Ambient noise', where: 'the same geophones listening to footsteps and traffic, no hammer', distance: '12 m', verdict: `retrieves the wave (correlation ${am.retrieval.ncc.toFixed(2)}), but the image tops out at ${am.score.image_contrast_ensemble.toFixed(1)}× at any record length`, status: 'faint', href: '/seismic/#ambient' },
  { n: 5, name: 'Satellite radar', where: 'an ICEYE dwell, 24.5 s of aperture, 600 km up', distance: '607 km', verdict: `blind to the ground moving (${(sees.real.block.gain_complex * 100).toFixed(0)}% recovered), and the chamber’s imprint lies ${shortText} times below what it could detect`, status: 'nothing', href: '/satellite/' },
];
const label: Record<Status, string> = { found: 'recovered', faint: 'faint', nothing: 'sees nothing', next: 'next', planned: 'planned', measured: 'phase 2' };
---
<figure class="ladder">
  <svg viewBox="0 0 680 350" role="img" aria-label="The instruments, from a borehole beside a buried chamber to a satellite in orbit">
    <defs>
      <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#d9e3eb" />
        <stop offset="1" stop-color="#eef3f6" />
      </linearGradient>
      <linearGradient id="rock" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e3dccd" />
        <stop offset="1" stop-color="#cfc6b4" />
      </linearGradient>
      <pattern id="bed" width="28" height="12" patternUnits="userSpaceOnUse">
        <path d="M0 12h28M14 0v12" stroke="#b8ad97" stroke-width="0.7" fill="none" opacity="0.7" />
      </pattern>
    </defs>
    <rect width="680" height="150" fill="url(#sky)" />
    <rect y="150" width="680" height="200" fill="url(#rock)" />
    <rect y="150" width="680" height="200" fill="url(#bed)" />
    <line x1="0" x2="680" y1="150" y2="150" stroke="#8f8573" stroke-width="1.2" />

    <!-- 5 · the satellite and its line of sight -->
    <g class="sat">
      <path d="M590 40 L396 150 M612 44 L436 150" stroke="var(--cinnabar)" stroke-width="1" stroke-dasharray="4 4" opacity="0.7" />
      <rect x="592" y="30" width="18" height="12" rx="2" fill="#34495b" />
      <rect x="566" y="33" width="24" height="6" fill="#5b7894" />
      <rect x="612" y="33" width="24" height="6" fill="#5b7894" />
    </g>

    <!-- 4 · ambient noise: traffic far off, waves rolling in -->
    <g class="noise" stroke="#7f93a6" fill="none" stroke-width="1.1">
      <path d="M40 150 q8 -9 16 0 t16 0 t16 0 t16 0 t16 0" opacity="0.9" />
      <path d="M40 150 q8 9 16 0 t16 0 t16 0 t16 0 t16 0" opacity="0.5" />
      <rect x="24" y="136" width="18" height="9" rx="2" fill="#7f93a6" stroke="none" />
      <circle cx="28" cy="146" r="2" fill="#5d7082" stroke="none" />
      <circle cx="38" cy="146" r="2" fill="#5d7082" stroke="none" />
    </g>

    <!-- 2, 3 · the surface array -->
    <g fill="var(--ochre)">
      {Array.from({ length: 13 }, (_, i) => 200 + i * 20).map((x) => <path d={`M${x - 4} 150 L${x + 4} 150 L${x} 143 Z`} />)}
    </g>
    <g class="hammer">
      <rect x="226" y="126" width="3" height="16" fill="#34495b" />
      <rect x="220" y="122" width="15" height="6" rx="1" fill="#34495b" />
    </g>
    <!-- surface first arrivals skim the top of the rock -->
    <path d="M228 152 Q300 158 380 152" stroke="var(--ochre)" stroke-width="1" fill="none" opacity="0.7" />
    <!-- the chamber's echo rising to the array -->
    <g stroke="var(--lapis)" fill="none" stroke-width="1" stroke-dasharray="3 3" opacity="0.75">
      <path d="M318 222 A30 30 0 0 1 378 222" />
      <path d="M303 222 A45 45 0 0 1 393 222" />
      <path d="M288 222 A60 60 0 0 1 408 222" />
    </g>

    <!-- 1 · boreholes and crosshole rays bending round the chamber -->
    <g stroke="var(--ochre)">
      <line x1="262" y1="150" x2="262" y2="316" stroke-width="1.6" />
      <line x1="434" y1="150" x2="434" y2="316" stroke-width="1.6" />
    </g>
    <g fill="var(--ochre)">
      {Array.from({ length: 12 }, (_, i) => 172 + i * 12).map((y) => <circle cx="434" cy={y} r="1.8" />)}
      <path d="M262 232 l4 -8 l4 8 l-4 8 z" transform="translate(-4 0)" />
    </g>
    <g stroke="var(--verdigris)" fill="none" stroke-width="0.9" opacity="0.85">
      <path d="M262 232 L434 196" />
      <path d="M262 232 Q348 262 434 280" />
      <path d="M262 232 Q350 200 434 232" />
      <path d="M262 232 L434 304" />
    </g>

    <!-- the chamber -->
    <rect x="330" y="222" width="36" height="36" fill="var(--lapis)" fill-opacity="0.22" stroke="var(--lapis)" stroke-width="1.6" />
    <text x="348" y="274" class="lab" text-anchor="middle">chamber · 6 m · 12 m down</text>

    <!-- callouts -->
    <g class="call">
      <circle cx="248" cy="296" r="9" /><text x="248" y="300">1</text>
      <circle cx="200" cy="124" r="9" /><text x="200" y="128">2</text>
      <circle cx="420" cy="178" r="9" /><text x="420" y="182">3</text>
      <circle cx="78" cy="124" r="9" /><text x="78" y="128">4</text>
      <circle cx="552" cy="36" r="9" /><text x="552" y="40">5</text>
    </g>
    <text x="664" y="344" class="lab" text-anchor="end">schematic · not to scale</text>
  </svg>
  <table class="rungs">
    <tbody>
      {
        rungs.map((r) => (
          <tr>
            <td class="n">{r.n}</td>
            <td>
              <a href={`${base}${r.href}`}>{r.name}</a>
              <span class="where">{r.where}</span>
            </td>
            <td class="d num">{r.distance}</td>
            <td>
              <span class:list={['chip', r.status]}>{label[r.status]}</span>
              <span class="verdict">{r.verdict}</span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</figure>

<style>
  .ladder {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 24px;
    align-items: center;
    margin: 0;
  }
  svg {
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--sheet);
  }
  .lab {
    font: 9.5px var(--font-mono);
    fill: #4b5a66;
  }
  .call circle {
    fill: #132030;
  }
  .call text {
    font: 600 10px var(--font-mono);
    fill: #eef3f7;
    text-anchor: middle;
  }
  .rungs {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .rungs td {
    padding: 9px 8px 9px 0;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .rungs tr:last-child td {
    border-bottom: 0;
  }
  .n {
    font: 600 11px/1.6 var(--font-mono);
    color: var(--muted);
    width: 18px;
  }
  .rungs a {
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
  .rungs a:hover {
    color: var(--lapis);
  }
  .where {
    display: block;
    font-family: var(--font-serif);
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--muted);
  }
  .d {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--body);
    white-space: nowrap;
    text-align: right;
    padding-right: 14px;
  }
  .chip {
    display: inline-block;
    font: 600 9.5px/1 var(--font-mono);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 3px 8px;
    border: 1px solid currentColor;
    margin-bottom: 4px;
  }
  .chip.found {
    color: #fff;
    background: var(--verdigris);
    border-color: var(--verdigris);
  }
  .chip.faint {
    color: var(--verdigris);
    border-style: dashed;
  }
  .chip.nothing {
    color: var(--body);
  }
  .chip.next {
    color: var(--lapis);
    border-style: dashed;
  }
  .chip.planned {
    color: var(--muted);
    border-style: dashed;
  }
  .chip.measured {
    color: var(--cinnabar);
  }
  .verdict {
    display: block;
    font-size: 12px;
    line-height: 1.45;
    color: var(--body);
  }
  @media (max-width: 900px) {
    .ladder {
      grid-template-columns: 1fr;
    }
  }
</style>
