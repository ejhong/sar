---
/**
 * The sandstone band: the title, a line of Virgil, and beneath a hairline
 * the pages, sitting like tabs on the band's lower edge.
 */
import Seal from './Seal.astro';

interface Props {
  current?: string;
}
const { current = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { id: 'home', href: `${base}/`, label: 'Overview' },
  { id: 'pictures', href: `${base}/pictures/`, label: 'In pictures' },
  { id: 'satellite', href: `${base}/satellite/`, label: 'Satellite' },
  { id: 'seismic', href: `${base}/seismic/`, label: 'Seismic' },
  { id: 'ambient', href: `${base}/ambient/`, label: 'Ambient' },
  { id: 'underworld', href: `${base}/underworld/`, label: '3-D' },
  { id: 'claim', href: `${base}/claim/`, label: 'Claim' },
  { id: 'method', href: `${base}/method/`, label: 'Method' },
];
---
<header class="top-bar">
  <div class="titles">
    <a class="title" href={`${base}/`}><Seal />Underworld</a>
    <p class="subtitle-quote">
      “The descent to Avernus is easy … but to retrace the step and come out to the upper air, this is the task, this
      the labour.” <span class="attribution">— Virgil, Aeneid VI.126–129</span>
    </p>
  </div>
  <nav aria-label="Primary">
    {
      links.map((l) => (
        <a href={l.href} aria-current={current === l.id ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .top-bar {
    padding: 14px 24px 0;
    background: var(--deep);
    background-image: radial-gradient(120% 140% at 12% 0%, rgba(91, 143, 224, 0.12), transparent 60%);
    border-bottom: 1px solid #0b131c;
    flex-shrink: 0;
    color: var(--panel-text);
  }
  .title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-serif);
    font-size: 23px;
    font-weight: 500;
    letter-spacing: 0.4px;
    color: #eef3f7;
    text-decoration: none;
  }
  .title:hover {
    color: #fff;
  }
  .subtitle-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 12.5px;
    color: var(--panel-muted);
    margin-top: 4px;
    line-height: 1.5;
    max-width: 900px;
  }
  .attribution {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 9.5px;
    letter-spacing: 0.3px;
    opacity: 0.8;
    white-space: nowrap;
  }
  nav {
    display: flex;
    gap: 26px;
    margin-top: 12px;
    border-top: 1px solid rgba(223, 230, 236, 0.08);
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav::-webkit-scrollbar {
    display: none;
  }
  nav a {
    flex: none;
    font-size: 12.5px;
    letter-spacing: 0.2px;
    color: var(--panel-muted);
    text-decoration: none;
    padding: 9px 0 8px;
    margin-bottom: -1px;
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  nav a:hover {
    color: var(--panel-text);
    border-bottom-color: var(--panel-line);
  }
  nav a[aria-current='page'] {
    color: #f3f7fa;
    font-weight: 500;
    border-bottom-color: var(--lapis-night);
  }
  @media (max-width: 760px) {
    .top-bar {
      padding: 11px 16px 0;
    }
    .subtitle-quote {
      display: none;
    }
    nav {
      gap: 18px;
      margin-top: 8px;
    }
  }
  @media (max-width: 480px) {
    nav {
      flex-wrap: wrap;
      gap: 0 14px;
    }
    nav a {
      font-size: 12px;
      letter-spacing: 0;
    }
  }
</style>
