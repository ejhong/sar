---
/**
 * The underworld: a deep-water panel beside the block diagram. The first
 * choice is the site; the second is what to show — the truth in the ground,
 * what an instrument recovered, or the waves themselves.
 */
interface Props {
  mode?: 'full' | 'embed';
  initial?: string;
}
const { mode = 'full', initial } = Astro.props;
---
<div class:list={['uw', mode]} data-theme="night" data-initial={initial} data-hash={mode === 'full' ? '1' : undefined}>
  <aside class="uw-panel" aria-label="Sites and view">
    <div class="uw-panel-head">
      <span class="uw-panel-title">The underworld</span>
      <span class="uw-seg-toggle" role="group" aria-label="Ground">
        <button type="button" data-theme="night" aria-pressed="true">night</button>
        <button type="button" data-theme="day" aria-pressed="false">day</button>
      </span>
    </div>
    <div class="uw-panel-body">
      <section class="uw-block">
        <div class="uw-label">Site</div>
        <div class="uw-sites" data-uw="sites"></div>
      </section>
      <section class="uw-block">
        <div class="uw-label">Show</div>
        <div class="uw-modes" role="group" aria-label="What to show">
          <button type="button" data-mode="truth" aria-pressed="true"><span class="uw-dot surveyed"></span>Truth</button>
          <button type="button" data-mode="recovered" aria-pressed="false"><span class="uw-dot recovered"></span>Recovered</button>
          <button type="button" data-mode="waves" aria-pressed="false"><span class="uw-dot wave"></span>Waves</button>
          <button type="button" data-mode="satellite" aria-pressed="false"><span class="uw-dot radar"></span>Satellite</button>
        </div>
        <div class="uw-mode-context" data-uw="mode-context"></div>
      </section>
      <details class="uw-block" open>
        <summary class="uw-label">View</summary>
        <label class="uw-range"><span>Ground</span><input type="range" min="0" max="1" step="0.01" value="0.62" data-uw="ground" /></label>
        <label class="uw-range"><span>Cut from the south</span><input type="range" min="0" max="0.95" step="0.005" value="0" data-uw="cut" /></label>
        <label class="uw-range"><span>Vertical scale</span><input type="range" min="0.3" max="3" step="0.05" value="1" data-uw="exaggeration" /></label>
        <button type="button" class="uw-btn" data-uw="reset">Reset view</button>
      </details>
      <details class="uw-block">
        <summary class="uw-label">Layers</summary>
        <label class="uw-check"><input type="checkbox" data-layer="features" checked /><span class="uw-dot surveyed"></span>Chambers and voids</label>
        <label class="uw-check"><input type="checkbox" data-layer="claimed" checked /><span class="uw-dot claimed"></span>Claimed structures</label>
        <label class="uw-check"><input type="checkbox" data-layer="structures" checked /><span class="uw-dot structure"></span>Monuments</label>
        <label class="uw-check"><input type="checkbox" data-layer="volumes" checked /><span class="uw-dot recovered"></span>Recovered volume</label>
        <label class="uw-check"><input type="checkbox" data-layer="stations" checked /><span class="uw-dot sensor"></span>Sensors and sources</label>
        <label class="uw-check"><input type="checkbox" data-layer="waves" checked /><span class="uw-dot wave"></span>Waves</label>
        <label class="uw-check"><input type="checkbox" data-layer="walls" checked /><span class="uw-dot strata"></span>Strata on the faces</label>
        <label class="uw-check"><input type="checkbox" data-layer="frame" checked /><span class="uw-dot frame"></span>Frame and north</label>
      </details>
      <details class="uw-block" open>
        <summary class="uw-label">Composition</summary>
        <div data-uw="composition"></div>
      </details>
      <details class="uw-block">
        <summary class="uw-label">Notes</summary>
        <div class="uw-notes" data-uw="notes"></div>
      </details>
      <p class="uw-keys">keys · 1–4 site · t truth · v recovered · w waves · s satellite · space play · r reset · esc unpin</p>
    </div>
  </aside>
  <div class="uw-stage">
    <canvas aria-label="Three-dimensional block diagram of the selected site"></canvas>
    <div class="uw-title" data-uw="title"></div>
    <div class="uw-card" data-uw="card" hidden>
      <button type="button" class="uw-unpin" data-uw="unpin" aria-label="Unpin">×</button>
      <div data-uw="card-body"></div>
    </div>
    <div class="uw-foot">
      <span class="uw-legend">
        <span><span class="uw-dot surveyed"></span>chamber or void</span>
        <span><span class="uw-dot claimed"></span>claimed</span>
        <span><span class="uw-dot recovered"></span>recovered</span>
        <span><span class="uw-dot radar"></span>radar</span>
        <span><span class="uw-dot sensor"></span>sensor</span>
      </span>
      <span class="uw-scalebar" data-uw="scalebar"><i></i><span></span></span>
      <span class="uw-scale" data-uw="scale"></span>
    </div>
    {mode === 'embed' && <div class="uw-hint" data-uw="hint" hidden>hold ctrl or ⌘ and scroll to zoom · two fingers to turn</div>}
    <div class="uw-loading" data-uw="loading"><span class="ring"></span><span class="ring r2"></span></div>
  </div>
</div>

<script>
  import { Underworld } from '../viewer/Underworld';
  for (const root of document.querySelectorAll<HTMLElement>('.uw')) {
    const uw = new Underworld({
      root,
      initial: root.dataset.initial,
      hash: root.dataset.hash === '1',
      embedded: root.classList.contains('embed'),
    });
    uw.start().catch((e) => {
      console.error(e);
      const t = root.querySelector('[data-uw=title]');
      if (t) t.textContent = 'The viewer could not start: ' + (e?.message ?? e);
    });
  }
</script>

<style is:global>
  .uw {
    display: grid;
    grid-template-columns: 296px minmax(0, 1fr);
    gap: 12px;
    min-height: 0;
  }
  .uw.full {
    flex: 1;
  }
  .uw.embed {
    height: min(78vh, 720px);
    min-height: 520px;
  }
  .uw-panel {
    background: var(--panel-bg);
    color: var(--panel-text);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    border: 1px solid #0b131c;
  }
  .uw-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 12px 14px;
    background: var(--panel-head);
    border-bottom: 1px solid var(--panel-line);
  }
  .uw-panel-title {
    font-family: var(--font-serif);
    font-size: 16px;
    font-weight: 500;
    color: #eef3f7;
  }
  .uw-seg-toggle {
    display: inline-flex;
    border: 1px solid var(--panel-line);
    border-radius: 999px;
    overflow: hidden;
  }
  .uw-seg-toggle button {
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.3px;
    color: var(--panel-faint);
    background: transparent;
    border: 0;
    padding: 5px 10px;
    cursor: pointer;
  }
  .uw-seg-toggle button[aria-pressed='true'] {
    color: var(--panel-text);
    background: var(--panel-line);
  }
  .uw-panel-body {
    flex: 1;
    overflow-y: auto;
    padding: 2px 0 12px;
    background: var(--panel-body);
    scrollbar-width: thin;
    scrollbar-color: #33475c transparent;
  }
  .uw-block {
    padding: 0 14px 12px;
    border-bottom: 1px solid var(--panel-line);
  }
  .uw-label {
    display: block;
    font: 600 10px/1 var(--font-mono);
    letter-spacing: 0.9px;
    text-transform: uppercase;
    color: var(--panel-faint);
    padding: 14px 0 9px;
    list-style: none;
    cursor: default;
  }
  summary.uw-label {
    cursor: pointer;
    position: relative;
  }
  summary.uw-label::-webkit-details-marker {
    display: none;
  }
  summary.uw-label::after {
    content: '+';
    position: absolute;
    right: 0;
    color: var(--panel-faint);
  }
  details[open] > summary.uw-label::after {
    content: '−';
  }
  .uw-group {
    font: 500 9.5px/1 var(--font-mono);
    color: var(--panel-faint);
    margin: 4px 0 4px;
  }
  .uw-site {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 8px;
    width: calc(100% + 16px);
    text-align: left;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 6px 8px;
    margin: 0 -8px 1px;
    color: var(--panel-text);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .uw-site:hover {
    background: rgba(255, 255, 255, 0.035);
  }
  .uw-site[aria-current='true'] {
    background: rgba(130, 179, 255, 0.08);
    border-color: rgba(130, 179, 255, 0.28);
  }
  .uw-site-key {
    font: 500 10px/1.9 var(--font-mono);
    color: var(--panel-faint);
    text-align: center;
  }
  .uw-site-name {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 600;
  }
  .uw-site-runs {
    font: 500 9px/1 var(--font-mono);
    color: #0f1822;
    background: var(--verdigris-night);
    border-radius: 999px;
    padding: 2px 5px;
  }
  .uw-site-sub {
    display: block;
    font-size: 11px;
    line-height: 1.4;
    color: var(--panel-muted);
    margin-top: 1px;
  }
  .uw-site:not([aria-current='true']) .uw-site-sub {
    display: none;
  }
  .uw-modes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
    background: var(--panel-head);
    border: 1px solid var(--panel-line);
    border-radius: 9px;
    padding: 3px;
  }
  .uw-modes button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    font: 500 11.5px/1 var(--font-sans);
    color: var(--panel-muted);
    background: transparent;
    border: 0;
    border-radius: 6px;
    padding: 8px 4px;
    cursor: pointer;
  }
  .uw-modes button .uw-dot {
    margin: 0;
  }
  .uw-modes button[aria-pressed='true'] {
    background: var(--panel-line);
    color: #f1f5f8;
  }
  .uw-modes button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .uw-mode-context {
    margin-top: 10px;
  }
  .uw-subhead {
    font: 600 9.5px/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--panel-faint);
    margin: 14px 0 6px;
  }
  .uw-subhead:first-child {
    margin-top: 2px;
  }
  .uw-ctx-note {
    font-family: var(--font-serif);
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--panel-muted);
  }
  .uw-inline {
    white-space: nowrap;
  }
  .uw-radio {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 6px;
    align-items: start;
    padding: 5px 0;
    cursor: pointer;
  }
  .uw-radio input {
    margin-top: 3px;
    accent-color: var(--verdigris-night);
  }
  .uw-opt-name {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--panel-text);
  }
  .uw-opt-sub {
    display: block;
    font-size: 10.5px;
    line-height: 1.4;
    color: var(--panel-muted);
  }
  .uw-timeline {
    display: grid;
    grid-template-columns: 30px 1fr auto;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
  }
  .uw-play {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid var(--panel-line);
    background: var(--panel-head);
    color: var(--panel-text);
    font-size: 10px;
    cursor: pointer;
  }
  .uw-time {
    font: 500 10.5px var(--font-mono);
    color: var(--panel-muted);
    min-width: 52px;
    text-align: right;
  }
  .uw-check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--panel-muted);
    padding: 3px 0;
    cursor: pointer;
  }
  .uw-check input,
  .uw-range input,
  .uw-timeline input {
    accent-color: #8aa4b8;
  }
  .uw-range {
    display: grid;
    gap: 3px;
    font: 500 10px/1.3 var(--font-mono);
    color: var(--panel-faint);
    padding: 6px 0 2px;
  }
  .uw-range input,
  .uw-timeline input {
    width: 100%;
  }
  .uw-btn {
    margin-top: 8px;
    font: 500 10.5px/1 var(--font-mono);
    color: var(--panel-muted);
    background: transparent;
    border: 1px solid var(--panel-line);
    border-radius: 6px;
    padding: 6px 10px;
    cursor: pointer;
  }
  .uw-btn:hover {
    color: var(--panel-text);
  }
  .uw-keys {
    font: 9.5px/1.6 var(--font-mono);
    color: var(--panel-faint);
    padding: 12px 14px 0;
  }
  .uw-dot {
    display: inline-block;
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 6px;
    background: var(--lapis-night);
    box-shadow: 0 0 6px rgba(130, 179, 255, 0.55);
  }
  .uw-dot.truth,
  .uw-dot.surveyed {
    background: var(--lapis-night);
  }
  .uw-dot.claimed {
    background: transparent;
    border: 1.5px dashed var(--porphyry-night);
    box-shadow: none;
  }
  .uw-dot.representative {
    background: transparent;
    border: 1.5px solid var(--lapis-night);
  }
  .uw-dot.recovered {
    background: var(--verdigris-night);
    box-shadow: 0 0 6px rgba(116, 216, 188, 0.5);
  }
  .uw-dot.radar {
    background: var(--cinnabar-night);
    box-shadow: 0 0 6px rgba(240, 144, 111, 0.5);
  }
  .uw-dot.wave {
    background: radial-gradient(circle, #f3ead6 0 30%, transparent 32% 55%, #f3ead6 57% 72%, transparent 74%);
    box-shadow: none;
  }
  .uw-dot.sensor {
    background: var(--ochre-night);
    border-radius: 1px;
    box-shadow: none;
  }
  .uw-dot.structure {
    background: transparent;
    border: 1.5px solid #dfe6ec;
    border-radius: 1px;
    box-shadow: none;
  }
  .uw-dot.strata {
    background: repeating-linear-gradient(0deg, #6f7682 0 2px, #2a3542 2px 4px);
    border-radius: 1px;
    box-shadow: none;
  }
  .uw-dot.frame {
    background: transparent;
    border: 1px solid #5d7082;
    border-radius: 0;
    box-shadow: none;
  }
  .uw-mat {
    display: grid;
    grid-template-columns: 12px 1fr auto;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    color: var(--panel-muted);
    padding: 3px 0;
  }
  .uw-swatch {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.25);
  }
  .uw-mat-v {
    font: 10px/1 var(--font-mono);
    color: var(--panel-faint);
    white-space: nowrap;
  }
  .uw-mat-foot {
    font: 9.5px/1.4 var(--font-mono);
    color: var(--panel-faint);
    margin-top: 6px;
  }
  .uw-notes p {
    font-family: var(--font-serif);
    font-size: 12px;
    line-height: 1.55;
    color: var(--panel-muted);
    margin-bottom: 7px;
  }

  .uw-stage {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--night);
    min-height: 0;
    border: 1px solid #0b131c;
    transition: background 0.3s;
  }
  .uw[data-theme='day'] .uw-stage {
    background: var(--bg);
    border-color: var(--border);
  }
  .uw-stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: none;
  }
  .uw-title {
    position: absolute;
    top: 16px;
    left: 18px;
    max-width: min(440px, 64%);
    pointer-events: none;
    color: var(--panel-text);
  }
  .uw[data-theme='day'] .uw-title {
    color: var(--text);
  }
  .uw-kind {
    font: 600 9.5px/1 var(--font-mono);
    letter-spacing: 0.9px;
    text-transform: uppercase;
    opacity: 0.62;
  }
  .uw-title h2 {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 500;
    color: inherit;
    margin: 6px 0 4px;
  }
  .uw-title p {
    font-family: var(--font-serif);
    font-size: 13px;
    line-height: 1.5;
    opacity: 0.78;
  }
  .uw-card {
    position: absolute;
    left: 16px;
    bottom: 48px;
    max-width: 370px;
    background: rgba(18, 28, 39, 0.9);
    border: 1px solid var(--panel-line);
    border-radius: 9px;
    padding: 10px 12px;
    color: var(--panel-text);
    pointer-events: none;
    backdrop-filter: blur(6px);
  }
  .uw-card.pinned {
    pointer-events: auto;
    border-color: rgba(130, 179, 255, 0.4);
  }
  .uw-unpin {
    display: none;
    position: absolute;
    top: 4px;
    right: 6px;
    border: 0;
    background: transparent;
    color: var(--panel-muted);
    font-size: 15px;
    cursor: pointer;
  }
  .uw-card.pinned .uw-unpin {
    display: block;
  }
  .uw-card-head {
    font-size: 13px;
    font-weight: 600;
    padding-right: 14px;
  }
  .uw-card-meta {
    font: 10px/1.5 var(--font-mono);
    color: var(--panel-muted);
    margin-top: 3px;
  }
  .uw-card-warn {
    display: inline-block;
    font: 600 9.5px/1 var(--font-mono);
    letter-spacing: 0.4px;
    color: #0f1822;
    background: var(--ochre-night);
    border-radius: 999px;
    padding: 3px 7px;
    margin-top: 6px;
  }
  .uw-card-src {
    font-family: var(--font-serif);
    font-size: 11.5px;
    line-height: 1.45;
    color: var(--panel-faint);
    margin-top: 5px;
  }
  .uw-foot {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    font: 10px/1.4 var(--font-mono);
    color: var(--panel-faint);
    pointer-events: none;
  }
  .uw[data-theme='day'] .uw-foot {
    color: var(--muted);
  }
  .uw-legend {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .uw-scalebar {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-left: auto;
  }
  .uw-scalebar i {
    display: inline-block;
    height: 5px;
    border: 1px solid currentColor;
    border-top: 0;
  }
  .uw-hint {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(18, 28, 39, 0.85);
    color: var(--panel-text);
    font: 11px/1.4 var(--font-mono);
    padding: 8px 12px;
    border-radius: 999px;
    pointer-events: none;
  }
  .uw-hint[hidden] {
    display: none;
  }
  .uw-loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .uw-loading[hidden] {
    display: none;
  }
  .uw-loading .ring {
    grid-area: 1 / 1;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1px solid var(--lapis-night);
    animation: uw-wave 1.6s var(--ease) infinite;
  }
  .uw-loading .r2 {
    animation-delay: 0.8s;
  }
  @keyframes uw-wave {
    from {
      transform: scale(0.3);
      opacity: 0.9;
    }
    to {
      transform: scale(4);
      opacity: 0;
    }
  }
  /* Phones and narrow windows: the viewer pinned above at a fixed height, the
     panel below scrolling on its own, so turning and scrolling never compete. */
  @media (max-width: 900px) {
    .uw {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(260px, 52%) minmax(0, 1fr);
      gap: 8px;
    }
    .uw.full {
      min-height: 0;
    }
    .uw.embed {
      height: 86vh;
      height: 86dvh;
      min-height: 560px;
    }
    .uw-panel {
      order: 2;
      min-height: 0;
    }
    .uw-stage {
      order: 1;
      min-height: 0;
    }
    .uw-title p,
    .uw-legend,
    .uw-scale,
    .uw-keys {
      display: none;
    }
  }
</style>
