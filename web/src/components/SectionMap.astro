---
/**
 * A vertical or horizontal slice through a tomogram, drawn at build time.
 * Diverging scale about the background: slower in verdigris (what the
 * instrument recovered as a possible void), faster in umber, the background
 * a neutral grey. True chambers are outlined in lapis; stations in ochre.
 * Hover reads the value of a cell.
 */
interface Props {
  title: string;
  x: number[]; // cell centres along the horizontal axis
  y: number[]; // cell centres along the vertical axis (top first)
  values: number[][]; // [row][col], rows follow y
  domain: number; // symmetric: -domain .. +domain
  outlines?: { x0: number; x1: number; y0: number; y1: number; label?: string }[];
  points?: [number, number][];
  xLabel: string;
  yLabel: string;
  caption?: string;
  width?: number;
  pct?: boolean;
  /** 'diverging' about zero (speed anomalies) or 'sequential' from zero (image amplitude). */
  scale?: 'diverging' | 'sequential';
}
const { title, x, y, values, domain, outlines = [], points = [], xLabel, yLabel, caption, width = 300, pct = true, scale = 'diverging' } = Astro.props;

// OKLab interpolation between three stops
function srgbToLinear(c: number) {
  c /= 255;
  return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
}
function linearToSrgb(c: number) {
  const v = c <= 0.0031308 ? 12.92 * c : 1.055 * Math.pow(c, 1 / 2.4) - 0.055;
  return Math.round(Math.min(Math.max(v, 0), 1) * 255);
}
function toOklab(hex: string) {
  const n = parseInt(hex.slice(1), 16);
  const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map(srgbToLinear);
  const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
  const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
  const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
  return [0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s, 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s, 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s];
}
function fromOklab([L, a, bb]: number[]) {
  const l = (L + 0.3963377774 * a + 0.2158037573 * bb) ** 3;
  const m = (L - 0.1055613458 * a - 0.0638541728 * bb) ** 3;
  const s = (L - 0.0894841775 * a - 1.291485548 * bb) ** 3;
  const r = 4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s;
  const g = -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s;
  const b = -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s;
  return `rgb(${linearToSrgb(r)},${linearToSrgb(g)},${linearToSrgb(b)})`;
}
const SLOW = toOklab('#0f6b57');
const MID = toOklab('#e9e5dd');
const FAST = toOklab('#7a5a36');
const SEQ0 = toOklab('#eef2f1');
const colour = (v: number) => {
  if (scale === 'sequential') {
    const k = Math.max(0, Math.min(1, v / domain));
    return fromOklab(SEQ0.map((q, i) => q + (SLOW[i] - q) * k));
  }
  const t = Math.max(-1, Math.min(1, v / domain));
  const [a, b] = t < 0 ? [MID, SLOW] : [MID, FAST];
  const k = Math.abs(t);
  return fromOklab(a.map((q, i) => q + (b[i] - q) * k));
};

const dx = Math.abs(x[1] - x[0]);
const dy = Math.abs(y[1] - y[0]);
const xmin = Math.min(...x) - dx / 2;
const xmax = Math.max(...x) + dx / 2;
const ymin = Math.min(...y) - dy / 2;
const ymax = Math.max(...y) + dy / 2;
const m = { l: 36, r: 8, t: 6, b: 30 };
const iw = width - m.l - m.r;
const ih = (iw * (ymax - ymin)) / (xmax - xmin);
const H = ih + m.t + m.b;
const sx = (v: number) => m.l + ((v - xmin) / (xmax - xmin)) * iw;
const sy = (v: number) => m.t + ((ymax - v) / (ymax - ymin)) * ih;
const cw = (dx / (xmax - xmin)) * iw;
const chh = (dy / (ymax - ymin)) * ih;
const ticks = (lo: number, hi: number) => {
  const span = hi - lo;
  const step = span > 60 ? 20 : span > 24 ? 10 : 5;
  const out: number[] = [];
  for (let v = Math.ceil(lo / step) * step; v <= hi; v += step) out.push(v);
  return out;
};
const fmt = (v: number) => (pct ? `${v > 0 ? '+' : ''}${(v * 100).toFixed(1)}%` : v.toFixed(2));
const legendStops = scale === 'sequential' ? [0, 0.25, 0.5, 0.75, 1] : [-1, -0.5, 0, 0.5, 1];
const data = JSON.stringify({ x, y, values, m, iw, ih, xmin, xmax, ymin, ymax, W: width, pct });
---
<figure class="sm">
  <figcaption class="sm-title">{title}</figcaption>
  <div class="sm-plot" data-map={data}>
    <svg viewBox={`0 0 ${width} ${H}`} role="img" aria-label={title}>
      <g>
        {
          values.map((row, i) =>
            row.map((v, j) => <rect x={sx(x[j]) - cw / 2} y={sy(y[i]) - chh / 2} width={cw + 0.3} height={chh + 0.3} fill={colour(v)} />),
          )
        }
      </g>
      {
        outlines.map((o) => (
          <rect class="sm-truth" x={sx(o.x0)} y={sy(o.y1)} width={sx(o.x1) - sx(o.x0)} height={sy(o.y0) - sy(o.y1)} />
        ))
      }
      {points
        .filter(([px, py]) => px >= xmin && px <= xmax && py >= ymin && py <= ymax)
        .map(([px, py]) => <rect class="sm-station" x={sx(px) - 2} y={sy(py) - 2} width="4" height="4" />)}
      <g class="sm-axis">
        {
          ticks(xmin, xmax).map((v) => (
            <text x={sx(v)} y={m.t + ih + 13} text-anchor="middle">
              {v}
            </text>
          ))
        }
        {
          ticks(ymin, ymax).map((v) => (
            <text x={m.l - 5} y={sy(v) + 3} text-anchor="end">
              {v}
            </text>
          ))
        }
        <text class="sm-label" x={m.l + iw / 2} y={H - 3} text-anchor="middle">{xLabel}</text>
        <text class="sm-label" x={9} y={m.t + ih / 2} text-anchor="middle" transform={`rotate(-90 9 ${m.t + ih / 2})`}>{yLabel}</text>
      </g>
      <rect class="sm-hit" x={m.l} y={m.t} width={iw} height={ih} fill="transparent" />
    </svg>
    <div class="sm-tip" hidden></div>
  </div>
  <div class="sm-legend">
    <span>{scale === 'sequential' ? 'faint' : 'slower'}</span>
    <span class="sm-ramp">{legendStops.map((t) => <i style={`background:${colour(t * domain)}`}></i>)}</span>
    <span>{scale === 'sequential' ? 'bright' : 'faster'}</span>
    {scale === 'diverging' && <span class="sm-range">±{pct ? `${(domain * 100).toFixed(0)}%` : domain}</span>}
    {outlines.length > 0 && <span class="sm-key"><b class="k-truth"></b>true chamber</span>}
    {points.length > 0 && <span class="sm-key"><b class="k-station"></b>stations</span>}
  </div>
  {caption && <p class="sm-caption">{caption}</p>}
</figure>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('.sm-plot')) {
    const d = JSON.parse(el.dataset.map!);
    const svg = el.querySelector('svg')!;
    const hit = svg.querySelector<SVGRectElement>('.sm-hit')!;
    const tip = el.querySelector<HTMLElement>('.sm-tip')!;
    hit.addEventListener('pointermove', (ev) => {
      const e = ev as PointerEvent;
      const r = svg.getBoundingClientRect();
      const px = ((e.clientX - r.left) / r.width) * d.W;
      const py = ((e.clientY - r.top) / r.width) * d.W;
      const xv = d.xmin + ((px - d.m.l) / d.iw) * (d.xmax - d.xmin);
      const yv = d.ymax - ((py - d.m.t) / d.ih) * (d.ymax - d.ymin);
      let j = 0,
        i = 0;
      d.x.forEach((v: number, k: number) => Math.abs(v - xv) < Math.abs(d.x[j] - xv) && (j = k));
      d.y.forEach((v: number, k: number) => Math.abs(v - yv) < Math.abs(d.y[i] - yv) && (i = k));
      const v = d.values[i][j];
      tip.hidden = false;
      tip.textContent = `${d.x[j]} m, ${d.y[i]} m · ${d.pct ? (v > 0 ? '+' : '') + (v * 100).toFixed(1) + '%' : v.toFixed(2)}`;
      tip.style.left = `${Math.min(e.clientX - r.left + 10, r.width - 150)}px`;
      tip.style.top = `${e.clientY - r.top + 10}px`;
    });
    hit.addEventListener('pointerleave', () => (tip.hidden = true));
  }
</script>

<style is:global>
  .sm {
    margin: 0;
    min-width: 0;
  }
  .sm-title {
    font-size: 12.5px;
    font-weight: 650;
    color: var(--text);
    margin-bottom: 6px;
  }
  .sm-plot {
    position: relative;
  }
  .sm-plot svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .sm-truth {
    fill: none;
    stroke: var(--lapis);
    stroke-width: 1.6;
  }
  .sm-station {
    fill: var(--ochre);
  }
  .sm-axis text {
    font: 9.5px var(--font-mono);
    fill: var(--muted);
  }
  .sm-tip {
    position: absolute;
    pointer-events: none;
    background: var(--sheet);
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    padding: 4px 7px;
    font: 10.5px/1.3 var(--font-mono);
    color: var(--text);
    white-space: nowrap;
  }
  .sm-tip[hidden] {
    display: none;
  }
  .sm-legend {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 10px;
    font: 10px var(--font-mono);
    color: var(--muted);
    margin-top: 6px;
  }
  .sm-ramp {
    display: inline-flex;
  }
  .sm-ramp i {
    width: 16px;
    height: 8px;
  }
  .sm-key {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .k-truth {
    width: 10px;
    height: 8px;
    border: 1.6px solid var(--lapis);
  }
  .k-station {
    width: 5px;
    height: 5px;
    background: var(--ochre);
  }
  .sm-caption {
    font-family: var(--font-serif);
    font-size: 12px;
    line-height: 1.55;
    color: var(--muted);
    margin-top: 6px;
  }
</style>
